.modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 58, 54, .42);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #faf9f7;
}

.create-modal {
  max-height: 88vh;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  margin: 14rpx 0;
  padding: 0 15rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 12rpx;
  color: #343a36;
  font-size: 28rpx;
  line-height: 72rpx;
}

.plan-time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 14rpx 0;
}

.plan-time-label {
  flex: 0 0 112rpx;
  color: #626b65;
  font-size: 26rpx;
  line-height: 42rpx;
}

.plan-time-picker {
  box-sizing: border-box;
  min-height: 74rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #343a36;
  font-size: 28rpx;
  line-height: 42rpx;
}

.plan-time-date {
  flex: 1;
  min-width: 0;
}

.plan-time-clock {
  flex: 0 0 180rpx;
}

.picker {
  margin: 14rpx 0;
  padding: 17rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #505a54;
}

.task-picker-trigger {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.task-picker-trigger.is-create-task {
  border: 1rpx solid #a9bdae;
  background: #e6ece7;
  color: #486455;
}

.task-picker-arrow {
  margin-left: 20rpx;
  color: #78947f;
  font-size: 38rpx;
  line-height: 1;
}

.derived-field {
  margin: -2rpx 0 14rpx;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.6;
}

.create-task-hint {
  color: #486455;
}

.task-picker-mask {
  z-index: 30;
}

.task-picker-modal {
  max-height: 72vh;
  overflow: hidden;
}

.task-option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.task-option {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  background: #f3f1ed;
  color: #343a36;
}

.task-option.selected {
  border-color: #78947f;
}

.task-option-create {
  border-color: #a9bdae;
  background: #e6ece7;
  color: #486455;
}

.task-option-copy {
  min-width: 0;
}

.task-option-title,
.task-option-meta {
  overflow: hidden;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-option-title {
  font-size: 28rpx;
  font-weight: 600;
}

.task-option-meta {
  margin-top: 4rpx;
  color: #626b65;
  font-size: 24rpx;
}

.task-option-create .task-option-meta {
  color: #4d695b;
}

.task-option-check {
  flex: 0 0 auto;
  margin-left: 20rpx;
  color: #55725e;
  font-size: 30rpx;
  font-weight: 700;
}

.priority-row,
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0;
}

.priority-choices {
  display: flex;
  gap: 16rpx;
}

.priority-choice {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.priority-choice.selected {
  outline: 5rpx solid #c7ccd6;
  outline-offset: 4rpx;
}

.priority-1 { background: #a7afbd; }
.priority-2 { background: #7f8ca1; }
.priority-3 { background: #68788f; }

.weekday-group {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #59635d;
  font-size: 24rpx;
}

.weekday {
  display: flex;
  align-items: center;
}

.month-day-scroll {
  box-sizing: border-box;
  height: 120rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f3f1ed;
}

.month-day-group {
  display: flex;
  flex-wrap: wrap;
  color: #59635d;
  font-size: 24rpx;
}

.month-day-option {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14.285714%;
  height: 60rpx;
}

.month-day-checkbox {
  margin-right: -4rpx;
  transform: scale(.72);
  transform-origin: center;
}

.repeat-interval-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 14rpx 0;
  color: #59635d;
  font-size: 26rpx;
}

.repeat-interval-input {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  line-height: 64rpx;
  text-align: center;
}

.repeat-frequency-picker {
  flex: 0 0 116rpx;
  width: 116rpx;
}

.repeat-frequency-field {
  box-sizing: border-box;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 14rpx;
  line-height: 64rpx;
  text-align: center;
}
