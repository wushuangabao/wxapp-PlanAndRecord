.lunar-date {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 44rpx;
  overflow: hidden;
  color: #626b65;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lunar-date.is-compact {
  height: 18rpx;
  font-size: 18rpx;
  line-height: 18rpx;
}
