.sheet-header { position: relative; min-height: 50rpx; margin-bottom: 20rpx; }
.sheet-title { margin: 0; padding-right: 190rpx; color: #343a36; font-size: 36rpx; font-weight: 700; }
.sheet-actions { position: static; }
.sheet-confirm { position: absolute; top: 50%; right: 82rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 80rpx; min-width: 80rpx; min-height: 52rpx; margin: 0; padding: 0; border-radius: 14rpx; background: #78947f; color: #faf9f7; font-size: 24rpx; font-weight: 700; line-height: 1; white-space: nowrap; transform: translateY(-50%); }
.sheet-cancel { position: absolute; top: 50%; right: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 56rpx; min-width: 56rpx; min-height: 52rpx; margin: 0; padding: 0; color: #4d695b; font-size: 25rpx; font-weight: 400; line-height: 1; white-space: nowrap; transform: translateY(-50%); }
