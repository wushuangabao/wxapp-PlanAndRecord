.page { padding: 44rpx 32rpx 72rpx; }.hero { margin-bottom: 28rpx; }.eyebrow { color: #16a34a; font-size: 21rpx; font-weight: 700; letter-spacing: 3rpx; }.title { margin-top: 14rpx; font-size: 56rpx; font-weight: 700; }.subtitle, .muted, .empty { color: #64748b; font-size: 25rpx; line-height: 1.6; }.risk, .warning { padding: 26rpx; border-radius: 20rpx; background: #fff7ed; color: #9a3412; font-size: 26rpx; line-height: 1.6; }.card { margin-top: 22rpx; padding: 30rpx; border-radius: 24rpx; background: #ffffff; }.section-title { margin-bottom: 18rpx; font-size: 32rpx; font-weight: 700; }.review-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.review-grid view { display: flex; flex-direction: column; padding: 18rpx; border-radius: 14rpx; background: #f0fdf4; color: #475569; font-size: 23rpx; }.metric { color: #166534; font-size: 42rpx; font-weight: 700; }.switch-row, .stat-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; }.stat-row { padding: 16rpx 0; border-bottom: 1rpx solid #f1f5f9; font-size: 26rpx; }.stat-row view:last-child { color: #475569; text-align: right; }.warning { margin-top: 22rpx; }.warning-detail { margin-top: 10rpx; font-size: 24rpx; }.input { box-sizing: border-box; width: 100%; min-height: 74rpx; margin: 14rpx 0; padding: 16rpx; border: 1rpx solid #cbd5e1; border-radius: 12rpx; }.primary, .secondary, .danger { margin-top: 14rpx; border-radius: 14rpx; font-size: 28rpx; }.primary { background: #22c55e; color: #052e16; font-weight: 700; }.secondary { background: #dcfce7; color: #166534; }.danger { background: #fee2e2; color: #b91c1c; font-weight: 700; }.category-row { padding: 22rpx 0; border-bottom: 1rpx solid #eef2f7; }.actions { display: flex; gap: 22rpx; margin-top: 12rpx; }.text-button { display: inline; margin: 0; padding: 0; background: transparent; color: #15803d; font-size: 25rpx; text-align: left; }
