.page {
  padding: 0 32rpx 72rpx;
}

.review-selector {
  position: sticky;
  z-index: 8;
  top: 0;
  margin: 0 -32rpx;
  padding: 18rpx 32rpx 16rpx;
  background: rgba(243, 241, 237, .97);
}

.review-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #e5e2dc;
}

.review-tab {
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  color: #626b65;
  font-size: 27rpx;
  line-height: 1.2;
  text-align: center;
}

.review-tab-active {
  background: #78947f;
  color: #faf9f7;
  font-weight: 700;
}

.period-controls {
  margin-top: 14rpx;
}

.period-scroll {
  width: 100%;
  white-space: nowrap;
}

.period-tabs {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 8rpx;
}

.period-tab {
  flex: none;
  min-width: 88rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 999rpx;
  background: #faf9f7;
  color: #626b65;
  font-size: 23rpx;
  text-align: center;
}

.period-tab-active {
  border-color: #a9bdae;
  background: #e6ece7;
  color: #486455;
  font-weight: 700;
}

.custom-period-form {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.custom-period-input {
  box-sizing: border-box;
  flex: 1;
  height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 12rpx;
  background: #faf9f7;
  color: #343a36;
  font-size: 25rpx;
}

.custom-period-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #d8e1da;
  color: #486455;
  font-size: 25rpx;
  font-weight: 700;
}

.empty,
.stat-hint,
.trend-hint {
  color: #626b65;
  font-size: 25rpx;
  line-height: 1.6;
}

.risk {
  margin-top: 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 25rpx;
  line-height: 1.6;
}

.card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #faf9f7;
}

.review-card {
  padding-top: 24rpx;
}

.review-range-label {
  margin-bottom: 18rpx;
  color: #486455;
  font-size: 25rpx;
  font-weight: 700;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.card > .section-title {
  margin-bottom: 18rpx;
}

.more-link {
  flex: none;
  padding: 10rpx 0 10rpx 16rpx;
  color: #4d695b;
  font-size: 24rpx;
}

.data-management-card {
  padding-bottom: calc(30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.storage-summary {
  min-width: 0;
  margin-bottom: 30rpx;
}

.storage-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
  color: #59635d;
  font-size: 25rpx;
  line-height: 1.5;
}

.storage-value {
  min-width: 0;
  color: #486455;
  font-weight: 700;
  overflow-wrap: anywhere;
  text-align: right;
}

.storage-track {
  height: 10rpx;
  margin: 14rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6ece7;
}

.storage-fill {
  height: 100%;
  border-radius: inherit;
  background: #78947f;
}

.storage-fill-warning {
  background: #a88a59;
}

.storage-warning {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 24rpx;
  line-height: 1.55;
}

.review-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.review-metric {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #e6ece7;
  color: #59635d;
  font-size: 22rpx;
  line-height: 1.45;
}

.metric {
  color: #486455;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.metric-value-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  min-width: 0;
}

.metric-note {
  color: #626b65;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.trend-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #dedad3;
}

.subsection-title {
  font-size: 28rpx;
  font-weight: 700;
}

.trend-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.trend-chart {
  display: flex;
  justify-content: center;
  align-items: stretch;
  gap: 6rpx;
  margin-top: 18rpx;
}

.trend-column {
  flex: 1 1 0;
  max-width: 86rpx;
  min-width: 0;
  text-align: center;
}

.trend-value,
.trend-label {
  color: #626b65;
  font-size: 19rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.trend-plot {
  position: relative;
  height: 136rpx;
  margin: 8rpx 4rpx;
}

.trend-plot::after {
  position: absolute;
  z-index: 0;
  top: 50%;
  right: -5rpx;
  left: -5rpx;
  height: 1rpx;
  background: #c8c4bd;
  content: "";
}

.trend-bar {
  position: absolute;
  z-index: 1;
  right: 14%;
  left: 14%;
  min-height: 2rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
}

.trend-bar-positive {
  bottom: 50%;
  background: #55725e;
}

.trend-bar-negative {
  top: 50%;
  border-radius: 2rpx 2rpx 6rpx 6rpx;
  background: #7f8ca1;
}

.trend-bar-zero {
  top: calc(50% - 1rpx);
  height: 3rpx;
  background: #78947f;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece9e4;
  font-size: 26rpx;
}

.stat-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  overflow-wrap: anywhere;
}

.selectable-row {
  min-height: 48rpx;
}

.selectable-row checkbox {
  flex: none;
  transform: scale(.78);
  transform-origin: left center;
}

.stat-value,
.variance-value {
  flex: none;
  color: #59635d;
  text-align: right;
}

.variance-row {
  align-items: flex-start;
}

.variance-row .stat-label {
  flex: 1;
}

.variance-value {
  display: flex;
  flex-direction: column;
  max-width: 60%;
  font-size: 22rpx;
  line-height: 1.45;
}

.variance-number {
  color: #486455;
  font-weight: 700;
}

.pie-layout {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.pie-chart-slot {
  display: flex;
  flex: 1;
  justify-content: center;
  min-width: 0;
}

.pie-legend {
  flex: none;
  width: 320rpx;
  min-width: 0;
  margin-left: auto;
}

.pie-legend-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 9rpx 0;
  color: #59635d;
  font-size: 22rpx;
}

.pie-swatch {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.pie-legend-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pie-legend-value {
  flex: none;
  min-width: 48rpx;
  color: #486455;
  font-weight: 700;
  text-align: right;
}

.pie-prompt {
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 24rpx;
  text-align: center;
}

.primary,
.secondary,
.danger {
  margin-top: 14rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.primary {
  background: #78947f;
  color: #faf9f7;
  font-weight: 700;
}

.secondary {
  background: #d8e1da;
  color: #486455;
}

.cloud-storage {
  background: #e3e8e3;
  color: #596b60;
}

.danger {
  background: #f2e3e1;
  color: #8a4945;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 58, 54, .42);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 82vh;
  padding: 36rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #faf9f7;
}

.detail-list {
  height: 60vh;
  margin-top: 12rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

@media (max-width: 350px) {
  .review-tab {
    font-size: 25rpx;
  }

  .variance-value {
    max-width: 56%;
  }
}
