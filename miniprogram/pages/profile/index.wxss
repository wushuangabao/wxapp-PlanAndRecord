.page {
  padding: 44rpx 32rpx 72rpx;
}

.eyebrow {
  position: sticky;
  z-index: 8;
  top: 0;
  padding: 14rpx 0;
  background: #f3f1ed;
  color: #55725e;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.empty,
.stat-hint {
  color: #626b65;
  font-size: 25rpx;
  line-height: 1.6;
}

.risk {
  padding: 26rpx;
  border-radius: 20rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #faf9f7;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.data-management-card {
  padding-bottom: calc(30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.storage-summary {
  min-width: 0;
  margin-bottom: 30rpx;
}

.storage-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
  color: #59635d;
  font-size: 25rpx;
  line-height: 1.5;
}

.storage-value {
  min-width: 0;
  color: #486455;
  font-weight: 700;
  overflow-wrap: anywhere;
  text-align: right;
}

.storage-track {
  height: 10rpx;
  margin: 14rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6ece7;
}

.storage-fill {
  height: 100%;
  border-radius: inherit;
  background: #78947f;
}

.storage-fill-warning {
  background: #a88a59;
}

.storage-warning {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 24rpx;
  line-height: 1.55;
}

.review-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.review-grid view {
  display: flex;
  flex-direction: column;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #e6ece7;
  color: #59635d;
  font-size: 23rpx;
}

.metric {
  color: #486455;
  font-size: 42rpx;
  font-weight: 700;
}

.switch-row,
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.stat-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ece9e4;
  font-size: 26rpx;
}

.stat-row view:last-child {
  color: #59635d;
  text-align: right;
}

.primary,
.secondary,
.danger {
  margin-top: 14rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.primary {
  background: #78947f;
  color: #faf9f7;
  font-weight: 700;
}

.secondary {
  background: #d8e1da;
  color: #486455;
}

.cloud-storage {
  background: #e3e8e3;
  color: #596b60;
}

.danger {
  background: #f2e3e1;
  color: #8a4945;
  font-weight: 700;
}
