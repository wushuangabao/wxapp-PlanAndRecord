<view class="page">
  <view class="eyebrow">ONE TIMELINE, THREE KINDS OF DATA</view>
  <view class="hero"><view class="title">日历</view></view>
  <view class="view-tabs"><view wx:for="{{views}}" wx:key="*this" class="tab {{view === item ? 'active' : ''}}" data-view="{{item}}" bindtap="changeView">{{item === 'day' ? '日' : item === 'week' ? '周' : item === 'month' ? '月' : '年'}}</view></view>
  <view class="range"><button class="nav-button" data-offset="-1" bindtap="moveRange">‹</button><view class="range-label">{{rangeLabel}}</view><button class="nav-button" data-offset="1" bindtap="moveRange">›</button></view>

  <view class="card form-card">
    <view class="section-title">新增计划</view>
    <input class="input" placeholder="计划标题" value="{{title}}" data-key="title" bindinput="onField" />
    <view class="datetime-row"><picker mode="date" value="{{startDate}}" data-key="startDate" bindchange="onField"><view>{{startDate}}</view></picker><picker mode="time" value="{{startTime}}" data-key="startTime" bindchange="onField"><view>{{startTime}}</view></picker></view>
    <view class="datetime-row"><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="onField"><view>{{endDate}}</view></picker><picker mode="time" value="{{endTime}}" data-key="endTime" bindchange="onField"><view>{{endTime}}</view></picker></view>
    <picker range="{{tasks}}" range-key="title" value="{{taskIndex}}" data-key="taskIndex" bindchange="onPicker"><view class="picker">任务（必选）：{{tasks[taskIndex].title || '请选择任务'}}</view></picker>
    <view wx:if="{{tasks[taskIndex].id}}" class="derived-field">项目归属（由任务决定）：{{tasks[taskIndex].derivedProjectName || '未关联项目'}}</view>
    <view class="priority-row"><view>优先级</view><view class="priority-choices"><view class="priority-choice priority-1 {{priority === 1 ? 'selected' : ''}}" data-priority="1" bindtap="choosePriority"></view><view class="priority-choice priority-2 {{priority === 2 ? 'selected' : ''}}" data-priority="2" bindtap="choosePriority"></view><view class="priority-choice priority-3 {{priority === 3 ? 'selected' : ''}}" data-priority="3" bindtap="choosePriority"></view></view></view>
    <view class="switch-row"><view>固定日程</view><switch checked="{{repeatEnabled}}" color="#16a34a" data-key="repeatEnabled" bindchange="onSwitch" /></view>
    <view wx:if="{{repeatEnabled}}" class="repeat-options"><picker range="{{frequencyLabels}}" value="{{frequencyIndex}}" data-key="frequencyIndex" bindchange="onPicker"><view class="picker">{{frequencyLabels[frequencyIndex]}}</view></picker><checkbox-group wx:if="{{frequencyIndex === 1}}" class="weekday-group" bindchange="onWeekdaysChange"><label wx:for="{{weekdayLabels}}" wx:key="*this" class="weekday"><checkbox value="{{index}}" checked="{{repeatWeekdays.indexOf(index) !== -1}}" color="#16a34a" />{{item}}</label></checkbox-group><input class="input" type="number" placeholder="重复间隔，例如 1" value="{{interval}}" data-key="interval" bindinput="onField" /></view>
    <view wx:if="{{!hasTaskOptions}}" class="form-hint">请先在“计划”页创建一个未完成任务。</view>
    <button class="primary {{!hasTaskOptions ? 'is-disabled' : ''}}" disabled="{{!hasTaskOptions}}" bindtap="createPlan">{{repeatEnabled ? '创建固定日程' : '创建计划块'}}</button>
  </view>

  <view class="legend"><view><text class="dot plan-dot"></text>计划</view><view><text class="dot candidate-dot"></text>候选</view><view><text class="dot actual-dot"></text>实际</view></view>
  <view wx:if="{{!timeline.length}}" class="empty">这个范围内还没有计划或记录。</view>
  <view wx:for="{{timeline}}" wx:key="id" class="timeline-item {{item.type}}">
    <view class="priority-mark priority-{{item.priority}}"></view>
    <view class="timeline-main">
      <view class="item-title">{{item.title}}</view>
      <view class="muted">{{item.displayTime}} · {{item.displayKind}}</view>
      <view class="actions">
        <button wx:if="{{(item.type === 'plan' || item.virtual) && item.canAssociate}}" class="text-button" data-item="{{item}}" bindtap="startTimerFromPlan">从此开始计时</button>
        <button wx:if="{{item.type === 'plan' && item.canEditPlan}}" class="text-button" data-item="{{item}}" bindtap="openPlanEditor">编辑计划</button>
        <button wx:if="{{item.type === 'plan'}}" class="danger-button" data-item="{{item}}" bindtap="deletePlan">删除计划</button>
        <button wx:if="{{item.type === 'candidate' && (!item.virtual || item.canAssociate)}}" class="text-button" data-item="{{item}}" bindtap="confirmItem">确认</button>
        <button wx:if="{{item.virtual}}" class="text-button" data-item="{{item}}" bindtap="openOccurrenceEditor">修改</button>
        <button wx:if="{{!item.virtual && item.type !== 'plan'}}" class="text-button" data-item="{{item}}" bindtap="openLogEditor">编辑</button>
        <button wx:if="{{item.type === 'candidate'}}" class="danger-button" data-item="{{item}}" bindtap="discardCandidate">作废</button>
        <button wx:if="{{item.type === 'confirmed'}}" class="danger-button" data-item="{{item}}" bindtap="deleteConfirmed">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{editor}}" class="modal-mask"><view class="modal"><view class="modal-title">修改重复实例</view><input class="input" value="{{editorTitle}}" data-key="editorTitle" bindinput="onEditorField" /><picker mode="date" value="{{editorDate}}" data-key="editorDate" bindchange="onEditorField"><view class="picker">{{editorDate}}</view></picker><view class="datetime-row"><picker mode="time" value="{{editorStart}}" data-key="editorStart" bindchange="onEditorField"><view>{{editorStart}}</view></picker><picker mode="time" value="{{editorEnd}}" data-key="editorEnd" bindchange="onEditorField"><view>{{editorEnd}}</view></picker></view><view class="priority-choices"><view class="priority-choice priority-1 {{editorPriority === 1 ? 'selected' : ''}}" data-priority="1" bindtap="chooseEditorPriority"></view><view class="priority-choice priority-2 {{editorPriority === 2 ? 'selected' : ''}}" data-priority="2" bindtap="chooseEditorPriority"></view><view class="priority-choice priority-3 {{editorPriority === 3 ? 'selected' : ''}}" data-priority="3" bindtap="chooseEditorPriority"></view></view><button class="secondary" bindtap="saveOccurrenceOverride">只修改此项</button><button class="primary" bindtap="saveRuleFollowing">修改此项及后续</button><button class="link" bindtap="closeOccurrenceEditor">取消</button></view></view>

  <view wx:if="{{planEditor}}" class="modal-mask"><view class="modal"><view class="modal-title">编辑计划块</view><input class="input" value="{{planTitle}}" data-key="planTitle" bindinput="onEditorField" /><picker mode="date" value="{{planStartDate}}" data-key="planStartDate" bindchange="onEditorField"><view class="picker">开始日期：{{planStartDate}}</view></picker><view class="datetime-row"><picker mode="time" value="{{planStartTime}}" data-key="planStartTime" bindchange="onEditorField"><view>{{planStartTime}}</view></picker><picker mode="time" value="{{planEndTime}}" data-key="planEndTime" bindchange="onEditorField"><view>{{planEndTime}}</view></picker></view><picker mode="date" value="{{planEndDate}}" data-key="planEndDate" bindchange="onEditorField"><view class="picker">结束日期：{{planEndDate}}</view></picker><picker range="{{planTasks}}" range-key="title" value="{{planTaskIndex}}" data-key="planTaskIndex" bindchange="onPicker"><view class="picker">任务（必选）：{{planTasks[planTaskIndex].title || '请选择任务'}}</view></picker><view wx:if="{{planTasks[planTaskIndex].id}}" class="derived-field">项目归属（由任务决定）：{{planTasks[planTaskIndex].derivedProjectName || '未关联项目'}}</view><view class="priority-choices"><view class="priority-choice priority-1 {{planPriority === 1 ? 'selected' : ''}}" data-priority="1" bindtap="choosePlanPriority"></view><view class="priority-choice priority-2 {{planPriority === 2 ? 'selected' : ''}}" data-priority="2" bindtap="choosePlanPriority"></view><view class="priority-choice priority-3 {{planPriority === 3 ? 'selected' : ''}}" data-priority="3" bindtap="choosePlanPriority"></view></view><button class="primary" bindtap="savePlanEditor">保存计划</button><button class="link" bindtap="closePlanEditor">取消</button></view></view>

  <view wx:if="{{logEditor}}" class="modal-mask"><view class="modal"><view class="modal-title">编辑时间记录</view><picker mode="date" value="{{logDate}}" data-key="logDate" bindchange="onEditorField"><view class="picker">{{logDate}}</view></picker><view class="datetime-row"><picker mode="time" value="{{logStart}}" data-key="logStart" bindchange="onEditorField"><view>{{logStart}}</view></picker><picker mode="time" value="{{logEnd}}" data-key="logEnd" bindchange="onEditorField"><view>{{logEnd}}</view></picker></view><picker range="{{logCategories}}" range-key="name" value="{{logCategoryIndex}}" data-key="logCategoryIndex" bindchange="onPicker"><view class="picker">分类：{{logCategories[logCategoryIndex].name || '未分类'}}</view></picker><picker range="{{logEvents}}" range-key="title" value="{{logEventIndex}}" data-key="logEventIndex" bindchange="onPicker"><view class="picker">计划块：{{logEvents[logEventIndex].title || '非计划实际'}}</view></picker><input class="input" placeholder="备注" value="{{logNote}}" data-key="logNote" bindinput="onEditorField" /><input class="input" placeholder="标签（用逗号分隔，可选）" value="{{logTagsText}}" data-key="logTagsText" bindinput="onEditorField" /><button class="primary" bindtap="saveLogEditor">保存记录</button><button class="link" bindtap="closeLogEditor">取消</button></view></view>
</view>
