<view class="page">
  <view class="calendar-toolbar">
    <view class="toolbar-left">
      <view class="range-label">{{rangeLabel}}</view>
      <view wx:if="{{!timeline.length}}" class="range-empty">这个范围内还没有计划或记录。</view>
    </view>
    <view class="toolbar-right">
      <view class="toolbar-controls">
        <view class="today-button {{rangeIncludesToday ? 'is-current-range' : ''}}" role="button" aria-label="回到今天" bindtap="goToday">今天</view>
        <view class="view-tabs">
          <view wx:for="{{views}}" wx:key="*this" class="tab {{view === item ? 'active' : ''}}" role="button" aria-label="切换到{{item === 'year' ? '年' : item === 'month' ? '月' : item === 'week' ? '周' : '日'}}视图" data-view="{{item}}" bindtap="changeView">{{item === 'year' ? '年' : item === 'month' ? '月' : item === 'week' ? '周' : '日'}}</view>
        </view>
      </view>
      <view class="calendar-legend" aria-label="日历状态图例">
        <view class="legend-item"><view class="legend-dot plan"></view><text>计划</text></view>
        <view class="legend-item"><view class="legend-dot candidate"></view><text>候选</text></view>
        <view class="legend-item"><view class="legend-dot actual"></view><text>实际</text></view>
      </view>
    </view>
  </view>

  <scroll-view
    class="calendar-scroll {{pageTurnClass}}"
    scroll-y="{{true}}"
    scroll-top="{{calendarScrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="{{calendarScrollWithAnimation}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bindscroll="onCanvasScroll"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchCancel"
  >
    <view class="calendar-grid" style="height: {{canvasHeight}}rpx;">
      <view class="time-axis" style="height: {{canvasHeight}}rpx;">
        <view wx:for="{{timeRows}}" wx:key="key" id="calendar-time-row-{{index}}" class="time-row" style="{{item.style}}">
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="schedule-canvas" style="height: {{canvasHeight}}rpx;">
        <view wx:for="{{timeRows}}" wx:key="key" class="grid-row" style="{{item.style}}"></view>
        <view wx:if="{{currentTimeLineStyle}}" class="current-time-line" style="{{currentTimeLineStyle}}" aria-hidden="true"></view>
        <view
          wx:for="{{timeline}}"
          wx:key="renderKey"
          id="{{item.domId}}"
          class="calendar-block {{item.visualType}} {{item.continuesBefore ? 'continues-before' : ''}} {{item.continuesAfter ? 'continues-after' : ''}} {{item.overlapMeta ? 'is-overlapping' : ''}}"
          style="{{item.blockStyle}}"
          role="button"
          aria-label="{{item.ariaLabel}}"
          data-item="{{item}}"
          bindtap="openItemDetail"
        >
          <view wx:if="{{item.continuesBefore}}" class="continuation continuation-before"></view>
          <view class="block-title">{{item.title}}</view>
          <view wx:if="{{item.continuesAfter}}" class="continuation continuation-after"></view>
        </view>
      </view>
      <view class="calendar-grid-bottom-line" aria-hidden="true"></view>
    </view>
    <view class="calendar-scroll-safe-space" aria-hidden="true"></view>
  </scroll-view>

  <view class="calendar-fab" role="button" aria-label="新增计划" bindtap="openCreatePlan">+</view>

  <view wx:if="{{isCreateOpen}}" class="modal-mask" bindtap="closeCreatePlan">
    <view class="modal create-modal" catchtap="noop">
      <sheet-header title="{{planEditor ? '编辑计划' : '新增计划'}}" show-confirm="{{true}}" confirm-text="{{planEditor ? '保存' : '创建'}}" bind:confirm="submitPlanForm" bind:cancel="closeCreatePlan" />
      <input class="input" maxlength="-1" placeholder="计划标题" value="{{title}}" data-key="title" bindinput="onTitleField" />
      <view class="plan-time-row"><view class="plan-time-label">开始时间</view><picker class="plan-time-picker plan-time-date" mode="date" value="{{startDate}}" data-key="startDate" bindchange="onField"><view>{{startDate}}</view></picker><picker class="plan-time-picker plan-time-clock" mode="time" value="{{startTime}}" data-key="startTime" bindchange="onField"><view>{{startTime}}</view></picker></view>
      <view class="plan-time-row"><view class="plan-time-label">结束时间</view><picker class="plan-time-picker plan-time-date" mode="date" value="{{endDate}}" data-key="endDate" bindchange="onField"><view>{{endDate}}</view></picker><picker class="plan-time-picker plan-time-clock" mode="time" value="{{endTime}}" data-key="endTime" bindchange="onField"><view>{{endTime}}</view></picker></view>
      <view wx:if="{{planEditor || hasAnyTasks}}" class="picker task-picker-trigger {{planFormTasks[planFormTaskIndex].optionType === 'create' ? 'is-create-task' : ''}}" role="button" aria-label="选择任务，当前为{{planFormTasks[planFormTaskIndex].title || '请选择任务'}}" aria-expanded="{{isTaskPickerOpen}}" bindtap="openTaskPicker">任务（必选）：{{planFormTasks[planFormTaskIndex].title || '请选择任务'}}<text class="task-picker-arrow">›</text></view>
      <view wx:if="{{(planEditor || hasAnyTasks) && planFormTasks[planFormTaskIndex].optionType === 'task'}}" class="derived-field">项目归属（由任务决定）：{{planFormTasks[planFormTaskIndex].derivedProjectName || '未关联项目'}}</view>
      <view wx:if="{{!planEditor && hasAnyTasks && planFormTasks[planFormTaskIndex].optionType === 'create'}}" class="derived-field create-task-hint">确认后将创建同名、未关联项目的 TODO。</view>
      <view class="priority-row"><view>优先级</view><view class="priority-choices"><view class="priority-choice priority-1 {{priority === 1 ? 'selected' : ''}}" role="button" aria-label="低优先级" data-priority="1" bindtap="choosePriority"></view><view class="priority-choice priority-2 {{priority === 2 ? 'selected' : ''}}" role="button" aria-label="中优先级" data-priority="2" bindtap="choosePriority"></view><view class="priority-choice priority-3 {{priority === 3 ? 'selected' : ''}}" role="button" aria-label="高优先级" data-priority="3" bindtap="choosePriority"></view></view></view>
      <view wx:if="{{!planEditor}}" class="switch-row"><view>固定日程</view><switch checked="{{repeatEnabled}}" color="#55725e" data-key="repeatEnabled" bindchange="onSwitch" /></view>
      <view wx:if="{{!planEditor && repeatEnabled}}" class="repeat-options">
        <view class="repeat-interval-row"><text>每隔</text><input class="input repeat-interval-input" type="number" value="{{repeatGap}}" aria-label="重复间隔，只能输入非负整数" bindinput="onRepeatGapInput" /><picker class="repeat-frequency-picker" range="{{frequencyUnits}}" value="{{frequencyIndex}}" data-key="frequencyIndex" aria-label="选择重复周期单位" bindchange="onPicker"><view class="picker repeat-frequency-field">{{frequencyUnits[frequencyIndex]}}</view></picker><text>{{repeatOccurrenceText}}</text></view>
        <checkbox-group wx:if="{{frequencyIndex === 1}}" class="weekday-group" bindchange="onWeekdaysChange"><label wx:for="{{weekdayOptions}}" wx:key="value" class="weekday"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#55725e" />{{item.label}}</label></checkbox-group>
        <scroll-view wx:if="{{frequencyIndex === 2}}" class="month-day-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <checkbox-group class="month-day-group" bindchange="onMonthDaysChange">
            <label wx:for="{{monthDayOptions}}" wx:key="value" class="month-day-option" aria-label="{{item.value}}号">
              <checkbox class="month-day-checkbox" value="{{item.value}}" checked="{{item.checked}}" color="#55725e" />{{item.label}}
            </label>
          </checkbox-group>
        </scroll-view>
      </view>
    </view>
  </view>

  <view wx:if="{{isTaskPickerOpen}}" class="modal-mask task-picker-mask" bindtap="closeTaskPicker">
    <view class="modal task-picker-modal" catchtap="noop">
      <sheet-header title="选择任务" bind:cancel="closeTaskPicker" />
      <scroll-view class="task-option-list" scroll-y="{{true}}" enable-flex="{{true}}" style="height: {{taskPickerListHeight}}rpx;">
        <block wx:for="{{planFormTasks}}" wx:key="id">
          <view
            wx:if="{{item.id}}"
            class="task-option {{item.optionType === 'create' ? 'task-option-create' : ''}} {{planFormTaskIndex === index ? 'selected' : ''}}"
            role="button"
            aria-label="{{item.optionType === 'create' ? '新建与计划同名的任务' : '选择任务' + item.title}}"
            aria-checked="{{planFormTaskIndex === index}}"
            data-index="{{index}}"
            bindtap="chooseTaskOption"
          >
            <view class="task-option-copy">
              <view class="task-option-title">{{item.title}}</view>
              <view class="task-option-meta">{{item.optionType === 'create' ? '自动创建与计划同名的任务，默认不关联项目' : item.derivedProjectName}}</view>
            </view>
            <view wx:if="{{planFormTaskIndex === index}}" class="task-option-check" aria-hidden="true">✓</view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{detailItem}}" class="modal-mask" bindtap="closeItemDetail">
    <view class="modal detail-modal" catchtap="noop">
      <sheet-header title="{{detailItem.isAggregate ? '重叠条目' : detailItem.title}}" bind:cancel="closeItemDetail" />
      <block wx:if="{{detailItem.isAggregate}}">
        <view class="aggregate-summary">此处还有 {{detailItem.hiddenCount}} 个重叠条目</view>
        <view class="aggregate-item-list">
          <view
            wx:for="{{detailItem.aggregateItems}}"
            wx:key="id"
            class="aggregate-item"
            role="button"
            aria-label="查看{{item.title}}，{{item.displayTime}}"
            data-item="{{item}}"
            bindtap="openItemDetail"
          >
            <view class="aggregate-item-title">{{item.title}}</view>
            <view class="aggregate-item-time">{{item.displayTime}}</view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="detail-time">{{detailItem.displayTime}}</view>
        <view wx:if="{{detailItem.displayTaskName}}" class="detail-row"><text>任务</text><text>{{detailItem.displayTaskName}}</text></view>
        <view wx:if="{{detailItem.displayProjectName}}" class="detail-row"><text>项目</text><text>{{detailItem.displayProjectName}}</text></view>
        <view wx:if="{{detailItem.displayPriority}}" class="detail-row"><text>优先级</text><text>{{detailItem.displayPriority}}</text></view>
        <view wx:if="{{detailItem.note}}" class="detail-row detail-row-stack"><text>备注</text><text>{{detailItem.note}}</text></view>
        <view wx:if="{{detailItem.displayTags}}" class="detail-row detail-row-stack"><text>标签</text><text>{{detailItem.displayTags}}</text></view>
        <view wx:if="{{detailItem.displayOverlap}}" class="detail-overlap">{{detailItem.displayOverlap}}</view>
        <view class="detail-actions">
          <view wx:if="{{detailItem.type === 'plan' && detailItem.canAssociate}}" class="detail-action primary-action" role="button" data-item="{{detailItem}}" bindtap="startTimerFromPlan">从此开始计时</view>
          <view wx:if="{{detailItem.type === 'plan' && !detailItem.virtual && detailItem.canEditPlan}}" class="detail-action" role="button" data-item="{{detailItem}}" bindtap="openPlanEditor">编辑计划</view>
          <view wx:if="{{detailItem.type === 'plan' && !detailItem.virtual}}" class="detail-action danger-action" role="button" data-item="{{detailItem}}" bindtap="deletePlan">删除计划</view>
          <view wx:if="{{detailItem.virtual}}" class="detail-action primary-action" role="button" data-item="{{detailItem}}" bindtap="confirmItem">确认</view>
          <view wx:if="{{detailItem.virtual}}" class="detail-action danger-action" role="button" aria-label="删除本次及后续" data-item="{{detailItem}}" bindtap="deleteRuleFollowing">删除本次及后续</view>
          <view wx:if="{{detailItem.virtual}}" class="detail-action danger-action" role="button" data-item="{{detailItem}}" bindtap="skipVirtualOccurrence">跳过</view>
          <view wx:if="{{detailItem.type === 'candidate' && !detailItem.virtual}}" class="detail-action primary-action" role="button" data-item="{{detailItem}}" bindtap="confirmItem">确认</view>
          <view wx:if="{{detailItem.type === 'candidate' && !detailItem.virtual}}" class="detail-action" role="button" data-item="{{detailItem}}" bindtap="openLogEditor">编辑确认</view>
          <view wx:if="{{detailItem.type === 'candidate' && !detailItem.virtual}}" class="detail-action danger-action" role="button" data-item="{{detailItem}}" bindtap="discardCandidate">作废</view>
          <view wx:if="{{detailItem.type === 'confirmed'}}" class="detail-action" role="button" data-item="{{detailItem}}" bindtap="openLogEditor">编辑</view>
          <view wx:if="{{detailItem.type === 'confirmed'}}" class="detail-action danger-action" role="button" data-item="{{detailItem}}" bindtap="deleteConfirmed">删除</view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{logEditor}}" class="modal-mask" bindtap="closeLogEditor">
    <view class="modal" catchtap="noop">
      <sheet-header title="编辑时间记录" show-confirm="{{true}}" bind:confirm="saveLogEditor" bind:cancel="closeLogEditor" />
      <view class="log-time-row">
        <view class="log-field-label">开始时间</view>
        <picker class="log-date-picker" mode="date" value="{{logStartDate}}" data-key="logStartDate" data-edited-key="logStartTimeEdited" bindchange="onLogDateChange"><view class="picker log-picker-field">{{logStartDate}}</view></picker>
        <second-time-picker class="log-second-picker" value="{{logStartTimeValue}}" data-key="logStartTimeValue" data-edited-key="logStartTimeEdited" bind:change="onLogTimeChange" />
      </view>
      <view class="log-time-row">
        <view class="log-field-label">结束时间</view>
        <picker class="log-date-picker" mode="date" value="{{logEndDate}}" data-key="logEndDate" data-edited-key="logEndTimeEdited" bindchange="onLogDateChange"><view class="picker log-picker-field">{{logEndDate}}</view></picker>
        <second-time-picker class="log-second-picker" value="{{logEndTimeValue}}" data-key="logEndTimeValue" data-edited-key="logEndTimeEdited" bind:change="onLogTimeChange" />
      </view>
      <view class="log-time-row">
        <view class="log-field-label">暂停时长</view>
        <pause-duration-input class="log-duration-input" value="{{logPausedDurationSeconds}}" bind:change="onLogPausedDurationChange" />
      </view>
      <picker range="{{logEvents}}" range-key="title" value="{{logEventIndex}}" data-key="logEventIndex" bindchange="onPicker"><view class="picker">计划块：{{logEvents[logEventIndex].title || '计划外'}}</view></picker>
      <input class="input" placeholder="备注" value="{{logNote}}" data-key="logNote" bindinput="onEditorField" />
      <view class="tag-editor" aria-label="标签"><view wx:for="{{logTags}}" wx:key="*this" class="tag-chip tag-chip-removable" role="button" data-tags-key="logTags" data-input-visible-key="logTagInputVisible" data-index="{{index}}" bindtap="removeTag" aria-label="移除标签 {{item}}">{{item}}<text class="tag-chip-remove">×</text></view><input wx:if="{{logTagInputVisible}}" class="tag-chip tag-input" focus maxlength="10" placeholder="输入新标签" data-tags-key="logTags" data-input-visible-key="logTagInputVisible" bindconfirm="addTag" bindblur="onTagInputBlur" /><view wx:else class="tag-chip tag-add" role="button" data-tags-key="logTags" data-input-visible-key="logTagInputVisible" bindtap="openTagInput" aria-label="添加标签">+</view></view>
      <view class="tag-hint">最多添加 {{maxTagsPerLog}} 个标签；每个最多 5 个汉字或 10 个英文字符（中英文折算）</view>
    </view>
  </view>
</view>
