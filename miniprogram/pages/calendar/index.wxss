.page { padding: 44rpx 32rpx 72rpx; }
.hero { margin-bottom: 26rpx; }.eyebrow { position: sticky; z-index: 8; top: 0; padding: 14rpx 0; background: #f8fafc; color: #16a34a; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }.title { margin-top: 12rpx; font-size: 56rpx; font-weight: 700; }
.view-tabs { display: flex; padding: 8rpx; border-radius: 18rpx; background: #e2e8f0; }.tab { flex: 1; padding: 14rpx 0; border-radius: 12rpx; color: #475569; text-align: center; }.tab.active { background: #ffffff; color: #166534; font-weight: 700; }
.range { display: flex; align-items: center; gap: 10rpx; margin: 22rpx 0; color: #334155; font-size: 26rpx; }.range-label { flex: 1; min-width: 0; overflow: hidden; text-align: center; text-overflow: clip; white-space: nowrap; }.nav-button { flex: 0 0 44rpx; width: 44rpx; height: 56rpx; margin: 0; padding: 0; border-radius: 50%; background: #ffffff; color: #166534; font-size: 36rpx; line-height: 50rpx; }
.card { margin-top: 22rpx; padding: 30rpx; border-radius: 24rpx; background: #ffffff; }.section-title { margin-bottom: 18rpx; font-size: 32rpx; font-weight: 700; }.input { box-sizing: border-box; width: 100%; min-height: 72rpx; margin: 14rpx 0; padding: 15rpx; border: 1rpx solid #cbd5e1; border-radius: 12rpx; }.datetime-row { display: flex; gap: 16rpx; margin: 14rpx 0; }.datetime-row picker { flex: 1; padding: 17rpx; border-radius: 12rpx; background: #f8fafc; }.picker { margin: 14rpx 0; padding: 17rpx; border-radius: 12rpx; background: #f8fafc; color: #334155; }
.derived-field, .form-hint { margin: -2rpx 0 14rpx; color: #64748b; font-size: 24rpx; line-height: 1.6; }.form-hint { margin-top: 14rpx; color: #b45309; }.primary.is-disabled { background: #e2e8f0; color: #94a3b8; }
.priority-row, .switch-row { display: flex; align-items: center; justify-content: space-between; margin: 20rpx 0; }.priority-choices { display: flex; gap: 16rpx; }.priority-choice { width: 40rpx; height: 40rpx; border-radius: 50%; }.priority-choice.selected { outline: 5rpx solid #bbf7d0; outline-offset: 4rpx; }.priority-1, .priority-mark.priority-1 { background: #bbf7d0; }.priority-2, .priority-mark.priority-2 { background: #4ade80; }.priority-3, .priority-mark.priority-3 { background: #15803d; }
.primary, .secondary { margin-top: 14rpx; border-radius: 14rpx; font-size: 28rpx; }.primary { background: #22c55e; color: #052e16; font-weight: 700; }.secondary { background: #dcfce7; color: #166534; }.weekday-group { display: flex; justify-content: space-between; padding: 14rpx 0; color: #475569; font-size: 24rpx; }.weekday { display: flex; align-items: center; }.legend { display: flex; gap: 24rpx; margin: 28rpx 0 14rpx; color: #475569; font-size: 24rpx; }.dot { display: inline-block; width: 14rpx; height: 14rpx; margin-right: 6rpx; border-radius: 50%; }.plan-dot { background: #3b82f6; }.candidate-dot { background: #f59e0b; }.actual-dot { background: #16a34a; }.empty, .muted { color: #64748b; font-size: 25rpx; line-height: 1.6; }.timeline-item { display: flex; margin-top: 14rpx; padding: 22rpx; border-radius: 18rpx; background: #ffffff; }.timeline-item.candidate { border: 1rpx dashed #f59e0b; }.timeline-item.confirmed { border-left: 8rpx solid #16a34a; }.priority-mark { width: 10rpx; flex: 0 0 10rpx; margin-right: 18rpx; border-radius: 8rpx; }.timeline-main { flex: 1; }.item-title { font-size: 29rpx; font-weight: 600; }.actions { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 14rpx; }.text-button, .danger-button, .link { display: inline; margin: 0; padding: 0; background: transparent; color: #15803d; font-size: 25rpx; text-align: left; }.danger-button { color: #dc2626; }.modal-mask { position: fixed; z-index: 9; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.45); }.modal { box-sizing: border-box; width: 100%; max-height: 90vh; overflow-y: auto; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #ffffff; }.modal-title { margin-bottom: 20rpx; font-size: 36rpx; font-weight: 700; }.modal .link { display: block; width: 100%; margin-top: 28rpx; text-align: center; }
