.page { padding: 44rpx 32rpx 72rpx; }
.eyebrow { position: sticky; z-index: 8; top: 0; padding: 14rpx 0; background: #f3f1ed; color: #55725e; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.view-tabs { display: flex; padding: 8rpx; border-radius: 18rpx; background: #e5e2dc; }.tab { flex: 1; padding: 14rpx 0; border-radius: 12rpx; color: #59635d; text-align: center; }.tab.active { background: #faf9f7; color: #486455; font-weight: 700; }
.range { display: flex; align-items: center; gap: 10rpx; margin: 22rpx 0; color: #505a54; font-size: 26rpx; }.range-label { flex: 1; min-width: 0; overflow: hidden; text-align: center; text-overflow: clip; white-space: nowrap; }.nav-button { flex: 0 0 44rpx; width: 44rpx; height: 56rpx; margin: 0; padding: 0; border-radius: 50%; background: #faf9f7; color: #486455; font-size: 36rpx; line-height: 50rpx; }
.card { margin-top: 22rpx; padding: 30rpx; border-radius: 24rpx; background: #faf9f7; }.section-title { margin-bottom: 18rpx; font-size: 32rpx; font-weight: 700; }.input { box-sizing: border-box; width: 100%; min-height: 72rpx; margin: 14rpx 0; padding: 15rpx; border: 1rpx solid #d0cdc6; border-radius: 12rpx; }.datetime-row { display: flex; gap: 16rpx; margin: 14rpx 0; }.datetime-row picker { flex: 1; padding: 17rpx; border-radius: 12rpx; background: #f3f1ed; }.picker { margin: 14rpx 0; padding: 17rpx; border-radius: 12rpx; background: #f3f1ed; color: #505a54; }
.log-time-row { display: flex; align-items: center; gap: 12rpx; margin: 18rpx 0; }.log-field-label { flex: 0 0 112rpx; color: #505a54; font-size: 26rpx; white-space: nowrap; }.log-date-picker { flex: 1 1 0; min-width: 0; }.log-picker-field { box-sizing: border-box; width: 100%; margin: 0; min-height: 72rpx; }.log-second-picker { flex: 0 0 190rpx; min-width: 0; }.log-duration-input { flex: 1 1 0; min-width: 0; }
.derived-field, .form-hint { margin: -2rpx 0 14rpx; color: #626b65; font-size: 24rpx; line-height: 1.6; }.form-hint { margin-top: 14rpx; color: #795d32; }.primary.is-disabled { background: #e5e2dc; color: #737b75; }
.tag-editor { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 14rpx 0 0; }.tag-chip { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 64rpx; margin: 0; padding: 0 22rpx; border: 0; border-radius: 12rpx; background: #d8e1da; color: #486455; font-size: 26rpx; line-height: 1.2; }.tag-chip-removable { max-width: 100%; }.tag-chip-remove { margin-left: 10rpx; color: #4d695b; font-size: 30rpx; line-height: 1; }.tag-add { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; padding: 0; background: #e6ece7; border: 1rpx dashed #a9bdae; color: #4d695b; font-size: 34rpx; font-weight: 400; }.tag-input { box-sizing: border-box; width: 176rpx; text-align: left; }.tag-hint { margin: 12rpx 0 14rpx; color: #626b65; font-size: 24rpx; line-height: 1.5; }
.priority-row, .switch-row { display: flex; align-items: center; justify-content: space-between; margin: 20rpx 0; }.priority-choices { display: flex; gap: 16rpx; }.priority-choice { width: 40rpx; height: 40rpx; border-radius: 50%; }.priority-choice.selected { outline: 5rpx solid #c2d0c5; outline-offset: 4rpx; }.priority-1, .priority-mark.priority-1 { background: #dce5de; }.priority-2, .priority-mark.priority-2 { background: #9fb4a4; }.priority-3, .priority-mark.priority-3 { background: #5f7b68; }
.primary, .secondary { margin-top: 14rpx; border-radius: 14rpx; font-size: 28rpx; }.primary { background: #78947f; color: #faf9f7; font-weight: 700; }.secondary { background: #d8e1da; color: #486455; }.weekday-group { display: flex; justify-content: space-between; padding: 14rpx 0; color: #59635d; font-size: 24rpx; }.weekday { display: flex; align-items: center; }.legend { display: flex; gap: 24rpx; margin: 28rpx 0 14rpx; color: #59635d; font-size: 24rpx; }.dot { display: inline-block; width: 14rpx; height: 14rpx; margin-right: 6rpx; border-radius: 50%; }.plan-dot { background: #7b918b; }.candidate-dot { background: #a58454; }.actual-dot { background: #55725e; }.empty, .muted { color: #626b65; font-size: 25rpx; line-height: 1.6; }.timeline-item { display: flex; margin-top: 14rpx; padding: 22rpx; border-radius: 18rpx; background: #faf9f7; }.timeline-item.plan { border-left: 8rpx solid #7b918b; }.timeline-item.candidate { border: 1rpx dashed #a58454; }.timeline-item.confirmed { border-left: 8rpx solid #55725e; }.priority-mark { width: 10rpx; flex: 0 0 10rpx; margin-right: 18rpx; border-radius: 8rpx; }.timeline-main { flex: 1; }.item-title { font-size: 29rpx; font-weight: 600; }.actions { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 14rpx; }.text-button, .danger-button { display: inline; margin: 0; padding: 0; background: transparent; color: #4d695b; font-size: 25rpx; text-align: left; }.danger-button { color: #9a5550; }.modal-mask { position: fixed; z-index: 9; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(52,58,54,.42); }.modal { box-sizing: border-box; width: 100%; max-height: 90vh; overflow-y: auto; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #faf9f7; }
.timeline-item.is-overlapping { background: #f8f5ee; box-shadow: inset 0 0 0 1rpx #d9c9aa; }
.overlap-note { margin-top: 8rpx; color: #795d32; font-size: 23rpx; line-height: 1.5; }
