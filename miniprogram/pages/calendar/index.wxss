.page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 22rpx 24rpx 0;
  overflow: hidden;
  background: #f3f1ed;
}

.calendar-toolbar {
  position: sticky;
  z-index: 8;
  top: 0;
  display: flex;
  flex: 0 0 auto;
  align-items: stretch;
  padding: 8rpx 0 12rpx;
  background: #f3f1ed;
}

.toolbar-left,
.toolbar-right {
  display: grid;
  grid-template-rows: 52rpx 44rpx;
  align-items: center;
  row-gap: 10rpx;
}

.toolbar-left {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 18rpx;
}

.range-heading {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  height: 52rpx;
  overflow: hidden;
}

.range-label {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 52rpx;
  overflow: hidden;
  color: #343a36;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-heading.is-compact-lunar {
  height: 68rpx;
  gap: 12rpx;
}

.range-heading.is-compact-lunar .range-label {
  height: 31rpx;
  line-height: 31rpx;
}

.range-empty {
  height: 20rpx;
  overflow: hidden;
  color: #737b75;
  font-size: 20rpx;
  line-height: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolbar-left > lunar-date,
.range-heading lunar-date {
  display: block;
  min-width: 0;
  overflow: hidden;
}

.toolbar-left > lunar-date {
  height: 44rpx;
}

.range-heading lunar-date {
  height: 18rpx;
}

.toolbar-right {
  flex: 0 0 auto;
  justify-items: end;
}

.toolbar-controls {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
}

.today-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 68rpx;
  height: 52rpx;
  padding: 0 12rpx;
  border: 0;
  border-radius: 12rpx;
  background: #faf9f7;
  color: #4d695b;
  font-size: 23rpx;
  text-align: center;
}

.today-button.is-current-range {
  border: 4rpx solid #a9bdae;
}

.view-tabs {
  display: flex;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #e5e2dc;
}

.tab {
  box-sizing: border-box;
  width: 54rpx;
  height: 42rpx;
  border-radius: 10rpx;
  color: #626b65;
  font-size: 23rpx;
  line-height: 42rpx;
  text-align: center;
}

.tab.active {
  background: #faf9f7;
  color: #486455;
  font-weight: 700;
}

.calendar-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  color: #626b65;
  font-size: 20rpx;
  line-height: 20rpx;
  height: 44rpx;
}

.calendar-filter-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 126rpx;
  height: 44rpx;
  margin-left: 2rpx;
  padding: 0 8rpx 0 10rpx;
  border: 2rpx solid #78947f;
  border-radius: 22rpx;
  background: #e6ece7;
  box-shadow: 0 2rpx 6rpx rgba(72, 100, 85, .14);
  color: #385846;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.calendar-filter-button:active {
  background: #d8e1da;
  transform: scale(.97);
}

.calendar-filter-label {
  white-space: nowrap;
}

.calendar-filter-switch-icon {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  color: #78947f;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.legend-dot {
  box-sizing: border-box;
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}

.legend-dot.plan {
  background: #7f8ca1;
}

.legend-dot.candidate {
  background: #a58454;
}

.legend-dot.actual {
  background: #55725e;
}

.calendar-scroll {
  box-sizing: border-box;
  flex: 1 1 0;
  min-height: 0;
  height: 0;
  overflow: hidden;
  border: 1rpx solid #dedad3;
  border-radius: 22rpx 22rpx 0 0;
  background: #f3f1ed;
  transform: translateX(0);
  will-change: transform, opacity;
}

.calendar-scroll.page-turn-next {
  animation: calendar-page-next 280ms ease-in-out;
}

.calendar-scroll.page-turn-previous {
  animation: calendar-page-previous 280ms ease-in-out;
}

.calendar-scroll.is-sheet-open {
  transform: none;
  will-change: auto;
}

@keyframes calendar-page-next {
  0% { opacity: 1; transform: translateX(0); }
  45% { opacity: .36; transform: translateX(-16%); }
  50% { opacity: .36; transform: translateX(16%); }
  100% { opacity: 1; transform: translateX(0); }
}

@keyframes calendar-page-previous {
  0% { opacity: 1; transform: translateX(0); }
  45% { opacity: .36; transform: translateX(16%); }
  50% { opacity: .36; transform: translateX(-16%); }
  100% { opacity: 1; transform: translateX(0); }
}

.calendar-grid {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  min-width: 0;
}

.time-axis {
  position: relative;
  z-index: 3;
  flex: 0 0 138rpx;
  width: 138rpx;
  overflow: hidden;
  background: #f6f4f0;
  box-shadow: 1rpx 0 0 #d0cdc6;
}

.time-row,
.grid-row {
  position: absolute;
  right: 0;
  left: 0;
}

.time-row {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 14rpx 12rpx 0 4rpx;
  border-bottom: 1rpx solid #dedad3;
  color: #737b75;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}

.schedule-canvas {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  background: #faf9f7;
}

.grid-row {
  box-sizing: border-box;
  border-bottom: 1rpx solid #dedad3;
}

.coarse-calendar-grid {
  display: block;
}

.coarse-calendar-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #dedad3;
}

.coarse-time-label {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 138rpx;
  align-items: flex-start;
  justify-content: flex-end;
  width: 138rpx;
  padding: 14rpx 12rpx 0 4rpx;
  background: #f6f4f0;
  box-shadow: 1rpx 0 0 #d0cdc6;
  color: #737b75;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
  user-select: none;
}

.coarse-time-label.is-collapsible {
  color: #4d695b;
}

.coarse-time-label.is-collapsible:active,
.coarse-time-label.is-drillable:active {
  background: #ece9e4;
}

.coarse-time-label-content {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.coarse-time-label.is-week .coarse-time-label-content {
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-start;
}

.coarse-time-label-text {
  min-width: 0;
}

.coarse-collapse-indicator {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 11rpx;
  height: 11rpx;
  margin: 0 3rpx 0 10rpx;
  border-right: 2rpx solid #78947f;
  border-bottom: 2rpx solid #78947f;
  transform: rotate(45deg);
  transform-origin: center;
}

.coarse-time-label.is-collapsed .coarse-collapse-indicator {
  transform: rotate(-45deg);
}

.coarse-time-label.is-week .coarse-collapse-indicator {
  margin: 12rpx 0 0;
}

.coarse-schedule-cell {
  position: relative;
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  background: #faf9f7;
}

.rest-day-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  z-index: 2;
  width: 0;
  height: 0;
  pointer-events: none;
  border-style: solid;
  border-width: 0 0 24rpx 24rpx;
  border-color: transparent transparent #9a938a transparent;
}

.rest-day-corner.rest-day-weekend {
  border-bottom-color: #9a938a;
}

.rest-day-corner.rest-day-holiday {
  border-bottom-color: #c17b70;
}

.coarse-block-list {
  box-sizing: border-box;
  display: flex;
  flex: 1 1 auto;
  flex-wrap: wrap;
  align-content: flex-start;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
  padding: 13rpx 12rpx;
}

.coarse-current-time-line {
  z-index: 5;
}

.calendar-grid-bottom-line {
  position: absolute;
  z-index: 7;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1rpx;
  background: #dedad3;
  pointer-events: none;
}

.current-time-line {
  position: absolute;
  z-index: 5;
  right: 0;
  left: 0;
  height: 3rpx;
  background: rgba(85, 114, 94, .72);
  pointer-events: none;
}

.current-time-line::before {
  position: absolute;
  top: 50%;
  left: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #55725e;
  content: '';
  transform: translateY(-50%);
}

.calendar-block {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  min-height: 54rpx;
  min-width: 0;
  overflow: hidden;
  border-radius: 10rpx;
  color: #343a36;
}

.calendar-block.coarse-calendar-block {
  position: relative;
  display: flex;
  flex: 0 1 auto;
  align-items: stretch;
  width: auto;
  max-width: 40vw;
  height: 54rpx;
  min-height: 54rpx;
}

.coarse-calendar-block .block-title {
  width: auto;
  max-width: 100%;
}

.calendar-block.is-segmented {
  min-height: 0;
  border-radius: 6rpx;
}

.calendar-block.plan {
  border-left: 7rpx solid #7f8ca1;
  background: #dde3ea;
  color: #47566b;
}

.calendar-block.plan.plan-priority-1 {
  border-left-color: #a7afbd;
  background: #eff1f4;
  color: #596577;
}

.calendar-block.plan.plan-priority-2 {
  border-left-color: #7f8ca1;
  background: #dde3ea;
  color: #47566b;
}

.calendar-block.plan.plan-priority-3 {
  border-left-color: #68788f;
  background: #c7ced8;
  color: #3f4d60;
}

.calendar-block.candidate {
  border: 2rpx dashed #a58454;
  background: #f5f0e6;
  color: #795d32;
}

.calendar-block.confirmed {
  border-left: 7rpx solid #55725e;
  background: #d8e1da;
  color: #385846;
}

.calendar-block.aggregate {
  z-index: 3;
  border: 2rpx solid #a9bdae;
  background: #e6ece7;
  color: #486455;
}

.calendar-block.aggregate .block-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 4rpx;
  font-weight: 700;
}

.calendar-block.is-overlapping {
  box-shadow: inset 0 0 0 2rpx #d9c9aa;
}

.calendar-block.is-handoff-highlight {
  z-index: 4;
  box-shadow: 0 0 0 4rpx #78947f;
}

.calendar-block.is-overlapping.is-handoff-highlight {
  box-shadow: inset 0 0 0 2rpx #d9c9aa, 0 0 0 4rpx #78947f;
}

.block-title {
  box-sizing: border-box;
  width: 100%;
  padding: 10rpx 12rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continuation {
  position: absolute;
  z-index: 4;
  left: 50%;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  background: #faf9f7;
  transform: translateX(-50%) rotate(45deg);
}

.continuation-before {
  top: -7rpx;
}

.continuation-after {
  bottom: -7rpx;
}

.calendar-scroll-safe-space {
  height: calc(196rpx + env(safe-area-inset-bottom));
  background: #f3f1ed;
}

.calendar-fab {
  position: fixed;
  z-index: 12;
  right: 34rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #78947f;
  box-shadow: 0 12rpx 28rpx rgba(72, 100, 85, .24);
  color: #faf9f7;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 94rpx;
  text-align: center;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin: 14rpx 0;
  padding: 15rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 12rpx;
}

.datetime-row {
  display: flex;
  gap: 16rpx;
  margin: 14rpx 0;
}

.datetime-row picker {
  flex: 1;
  padding: 17rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
}

.picker {
  margin: 14rpx 0;
  padding: 17rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #505a54;
}

.aggregate-summary {
  margin: 24rpx 0 14rpx;
  color: #626b65;
  font-size: 26rpx;
  line-height: 1.5;
}

.aggregate-item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.aggregate-item {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 14rpx;
  background: #f3f1ed;
}

.aggregate-item-title {
  overflow: hidden;
  color: #343a36;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aggregate-item-time {
  margin-top: 4rpx;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.4;
}

.log-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 0;
}

.log-field-label {
  flex: 0 0 112rpx;
  color: #505a54;
  font-size: 26rpx;
  white-space: nowrap;
}

.log-date-picker {
  flex: 1 1 0;
  min-width: 0;
}

.log-picker-field {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin: 0;
}

.log-second-picker {
  flex: 0 0 190rpx;
  min-width: 0;
}

.log-duration-input {
  flex: 1 1 0;
  min-width: 0;
}

.tag-editor {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 14rpx 0 0;
}

.tag-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 12rpx;
  background: #d8e1da;
  color: #486455;
  font-size: 26rpx;
  line-height: 1.2;
}

.tag-chip-removable {
  max-width: 100%;
}

.tag-chip-remove {
  margin-left: 10rpx;
  color: #4d695b;
  font-size: 30rpx;
  line-height: 1;
}

.tag-add {
  flex: 0 0 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  padding: 0;
  border: 1rpx dashed #a9bdae;
  background: #e6ece7;
  color: #4d695b;
  font-size: 34rpx;
  font-weight: 400;
}

.tag-input {
  box-sizing: border-box;
  width: 176rpx;
  text-align: left;
}

.tag-hint {
  margin: 12rpx 0 14rpx;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.5;
}

.secondary {
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #d8e1da;
  color: #486455;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 58, 54, .42);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #faf9f7;
}

.detail-modal {
  max-height: 78vh;
}

.detail-time {
  margin: 24rpx 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #505a54;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #dedad3;
  color: #343a36;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-row > text:first-child {
  flex: 0 0 100rpx;
  color: #737b75;
}

.detail-row > text:last-child {
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
}

.detail-row-stack {
  align-items: flex-start;
}

.detail-overlap {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 28rpx;
}

.detail-actions-start,
.detail-actions-end {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.detail-actions-start {
  justify-content: flex-start;
}

.detail-actions-end {
  justify-content: flex-end;
  margin-left: auto;
}

.detail-action {
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  background: #e6ece7;
  color: #486455;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.detail-action.primary-action {
  background: #78947f;
  color: #faf9f7;
}

.detail-action.danger-action {
  background: #f2e3e1;
  color: #8a4945;
}
