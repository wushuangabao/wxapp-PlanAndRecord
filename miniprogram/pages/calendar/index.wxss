.page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 22rpx 24rpx 0;
  overflow: hidden;
  background: #f3f1ed;
}

.calendar-toolbar {
  position: sticky;
  z-index: 8;
  top: 0;
  display: flex;
  flex: 0 0 auto;
  align-items: stretch;
  padding: 8rpx 0 12rpx;
  background: #f3f1ed;
}

.toolbar-left,
.toolbar-right {
  display: grid;
  grid-template-rows: 52rpx 20rpx;
  align-items: center;
  row-gap: 10rpx;
}

.toolbar-left {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 18rpx;
}

.range-label {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 52rpx;
  overflow: hidden;
  color: #343a36;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-empty {
  height: 20rpx;
  overflow: hidden;
  color: #737b75;
  font-size: 20rpx;
  line-height: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolbar-right {
  flex: 0 0 auto;
  justify-items: end;
}

.toolbar-controls {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
}

.today-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 68rpx;
  height: 52rpx;
  padding: 0 12rpx;
  border: 0;
  border-radius: 12rpx;
  background: #faf9f7;
  color: #4d695b;
  font-size: 23rpx;
  text-align: center;
}

.today-button.is-current-range {
  border: 4rpx solid #a9bdae;
}

.view-tabs {
  display: flex;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #e5e2dc;
}

.tab {
  box-sizing: border-box;
  width: 54rpx;
  height: 42rpx;
  border-radius: 10rpx;
  color: #626b65;
  font-size: 23rpx;
  line-height: 42rpx;
  text-align: center;
}

.tab.active {
  background: #faf9f7;
  color: #486455;
  font-weight: 700;
}

.calendar-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  color: #626b65;
  font-size: 20rpx;
  line-height: 20rpx;
  height: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.legend-dot {
  box-sizing: border-box;
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}

.legend-dot.plan {
  background: #7b918b;
}

.legend-dot.candidate {
  background: #a58454;
}

.legend-dot.actual {
  background: #55725e;
}

.calendar-scroll {
  box-sizing: border-box;
  flex: 1 1 0;
  min-height: 0;
  height: 0;
  overflow: hidden;
  border: 1rpx solid #dedad3;
  border-radius: 22rpx 22rpx 0 0;
  background: #f3f1ed;
  transform: translateX(0);
  will-change: transform, opacity;
}

.calendar-scroll.page-turn-next {
  animation: calendar-page-next 280ms ease-in-out;
}

.calendar-scroll.page-turn-previous {
  animation: calendar-page-previous 280ms ease-in-out;
}

@keyframes calendar-page-next {
  0% { opacity: 1; transform: translateX(0); }
  45% { opacity: .36; transform: translateX(-16%); }
  50% { opacity: .36; transform: translateX(16%); }
  100% { opacity: 1; transform: translateX(0); }
}

@keyframes calendar-page-previous {
  0% { opacity: 1; transform: translateX(0); }
  45% { opacity: .36; transform: translateX(16%); }
  50% { opacity: .36; transform: translateX(-16%); }
  100% { opacity: 1; transform: translateX(0); }
}

.calendar-grid {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  min-width: 0;
}

.time-axis {
  position: relative;
  z-index: 3;
  flex: 0 0 138rpx;
  width: 138rpx;
  overflow: hidden;
  background: #f6f4f0;
  box-shadow: 1rpx 0 0 #d0cdc6;
}

.time-row,
.grid-row {
  position: absolute;
  right: 0;
  left: 0;
}

.time-row {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 14rpx 12rpx 0 4rpx;
  border-bottom: 1rpx solid #dedad3;
  color: #737b75;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}

.schedule-canvas {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  background: #faf9f7;
}

.grid-row {
  box-sizing: border-box;
  border-bottom: 1rpx solid #dedad3;
}

.calendar-grid-bottom-line {
  position: absolute;
  z-index: 7;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1rpx;
  background: #dedad3;
  pointer-events: none;
}

.current-time-line {
  position: absolute;
  z-index: 5;
  right: 0;
  left: 0;
  height: 3rpx;
  background: rgba(85, 114, 94, .72);
  pointer-events: none;
}

.current-time-line::before {
  position: absolute;
  top: 50%;
  left: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #55725e;
  content: '';
  transform: translateY(-50%);
}

.calendar-block {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  min-height: 54rpx;
  min-width: 0;
  overflow: hidden;
  border-radius: 10rpx;
  color: #343a36;
}

.calendar-block.is-segmented {
  min-height: 0;
  border-radius: 6rpx;
}

.calendar-block.plan {
  border-left: 7rpx solid #7b918b;
  background: #e7edeb;
}

.calendar-block.candidate {
  border: 2rpx dashed #a58454;
  background: #f5f0e6;
  color: #795d32;
}

.calendar-block.confirmed {
  border-left: 7rpx solid #55725e;
  background: #d8e1da;
  color: #385846;
}

.calendar-block.aggregate {
  z-index: 3;
  border: 2rpx solid #a9bdae;
  background: #e6ece7;
  color: #486455;
}

.calendar-block.aggregate .block-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 4rpx;
  font-weight: 700;
}

.calendar-block.is-overlapping {
  box-shadow: inset 0 0 0 2rpx #d9c9aa;
}

.block-title {
  box-sizing: border-box;
  width: 100%;
  padding: 10rpx 12rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continuation {
  position: absolute;
  z-index: 4;
  left: 50%;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  background: #faf9f7;
  transform: translateX(-50%) rotate(45deg);
}

.continuation-before {
  top: -7rpx;
}

.continuation-after {
  bottom: -7rpx;
}

.calendar-scroll-safe-space {
  height: calc(196rpx + env(safe-area-inset-bottom));
  background: #f3f1ed;
}

.calendar-fab {
  position: fixed;
  z-index: 12;
  right: 34rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #78947f;
  box-shadow: 0 12rpx 28rpx rgba(72, 100, 85, .24);
  color: #faf9f7;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 94rpx;
  text-align: center;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin: 14rpx 0;
  padding: 15rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 12rpx;
}

.datetime-row {
  display: flex;
  gap: 16rpx;
  margin: 14rpx 0;
}

.datetime-row picker {
  flex: 1;
  padding: 17rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
}

.plan-time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 14rpx 0;
}

.plan-time-label {
  flex: 0 0 112rpx;
  color: #626b65;
  font-size: 26rpx;
  line-height: 42rpx;
}

.plan-time-picker {
  box-sizing: border-box;
  min-height: 74rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #343a36;
  font-size: 28rpx;
  line-height: 42rpx;
}

.plan-time-date {
  flex: 1;
  min-width: 0;
}

.plan-time-clock {
  flex: 0 0 180rpx;
}

.picker {
  margin: 14rpx 0;
  padding: 17rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #505a54;
}

.task-picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  box-sizing: border-box;
}

.task-picker-trigger.is-create-task {
  border: 1rpx solid #a9bdae;
  background: #e6ece7;
  color: #486455;
}

.task-picker-arrow {
  margin-left: 20rpx;
  color: #78947f;
  font-size: 38rpx;
  line-height: 1;
}

.derived-field,
.form-hint {
  margin: -2rpx 0 14rpx;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-hint {
  margin-top: 14rpx;
  color: #795d32;
}

.create-task-hint {
  color: #486455;
}

.task-picker-mask {
  z-index: 30;
}

.task-picker-modal {
  max-height: 72vh;
  overflow: hidden;
}

.task-option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.aggregate-summary {
  margin: 24rpx 0 14rpx;
  color: #626b65;
  font-size: 26rpx;
  line-height: 1.5;
}

.aggregate-item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.aggregate-item {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #d0cdc6;
  border-radius: 14rpx;
  background: #f3f1ed;
}

.aggregate-item-title {
  overflow: hidden;
  color: #343a36;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aggregate-item-time {
  margin-top: 4rpx;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.4;
}

.task-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  background: #f3f1ed;
  color: #343a36;
}

.task-option.selected {
  border-color: #78947f;
}

.task-option-create {
  border-color: #a9bdae;
  background: #e6ece7;
  color: #486455;
}

.task-option-copy {
  min-width: 0;
}

.task-option-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-option-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-option-create .task-option-meta {
  color: #4d695b;
}

.task-option-check {
  flex: 0 0 auto;
  margin-left: 20rpx;
  color: #55725e;
  font-size: 30rpx;
  font-weight: 700;
}

.log-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 0;
}

.log-field-label {
  flex: 0 0 112rpx;
  color: #505a54;
  font-size: 26rpx;
  white-space: nowrap;
}

.log-date-picker {
  flex: 1 1 0;
  min-width: 0;
}

.log-picker-field {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin: 0;
}

.log-second-picker {
  flex: 0 0 190rpx;
  min-width: 0;
}

.log-duration-input {
  flex: 1 1 0;
  min-width: 0;
}

.tag-editor {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 14rpx 0 0;
}

.tag-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 12rpx;
  background: #d8e1da;
  color: #486455;
  font-size: 26rpx;
  line-height: 1.2;
}

.tag-chip-removable {
  max-width: 100%;
}

.tag-chip-remove {
  margin-left: 10rpx;
  color: #4d695b;
  font-size: 30rpx;
  line-height: 1;
}

.tag-add {
  flex: 0 0 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  padding: 0;
  border: 1rpx dashed #a9bdae;
  background: #e6ece7;
  color: #4d695b;
  font-size: 34rpx;
  font-weight: 400;
}

.tag-input {
  box-sizing: border-box;
  width: 176rpx;
  text-align: left;
}

.tag-hint {
  margin: 12rpx 0 14rpx;
  color: #626b65;
  font-size: 24rpx;
  line-height: 1.5;
}

.priority-row,
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0;
}

.priority-choices {
  display: flex;
  gap: 16rpx;
}

.priority-choice {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.priority-choice.selected {
  outline: 5rpx solid #c2d0c5;
  outline-offset: 4rpx;
}

.priority-1 {
  background: #dce5de;
}

.priority-2 {
  background: #9fb4a4;
}

.priority-3 {
  background: #5f7b68;
}

.secondary {
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #d8e1da;
  color: #486455;
  font-size: 28rpx;
}

.weekday-group {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #59635d;
  font-size: 24rpx;
}

.weekday {
  display: flex;
  align-items: center;
}

.month-day-scroll {
  box-sizing: border-box;
  height: 120rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f3f1ed;
}

.month-day-group {
  display: flex;
  flex-wrap: wrap;
  color: #59635d;
  font-size: 24rpx;
}

.month-day-option {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14.285714%;
  height: 60rpx;
}

.month-day-checkbox {
  margin-right: -4rpx;
  transform: scale(.72);
  transform-origin: center;
}

.repeat-interval-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 14rpx 0;
  color: #59635d;
  font-size: 26rpx;
}

.repeat-interval-input {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  line-height: 64rpx;
  text-align: center;
}

.repeat-frequency-picker {
  flex: 0 0 116rpx;
  width: 116rpx;
}

.repeat-frequency-field {
  box-sizing: border-box;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 14rpx;
  line-height: 64rpx;
  text-align: center;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 58, 54, .42);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #faf9f7;
}

.create-modal {
  max-height: 88vh;
}

.detail-modal {
  max-height: 78vh;
}

.detail-time {
  margin: 24rpx 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f3f1ed;
  color: #505a54;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #dedad3;
  color: #343a36;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-row > text:first-child {
  flex: 0 0 100rpx;
  color: #737b75;
}

.detail-row > text:last-child {
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
}

.detail-row-stack {
  align-items: flex-start;
}

.detail-overlap {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f0e6;
  color: #795d32;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.detail-action {
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  background: #e6ece7;
  color: #486455;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.detail-action.primary-action {
  background: #78947f;
  color: #faf9f7;
}

.detail-action.danger-action {
  background: #f2e3e1;
  color: #8a4945;
}
