<view class="page">
  <view class="eyebrow">PLAN & RECORD</view>
  <view class="section recent-section">
    <view class="recent-header">
      <view class="section-title recent-title">最近记录</view>
      <view class="recent-action" role="button" aria-label="手工补录" bindtap="openManual">手工补录</view>
    </view>
    <view wx:if="{{!recentLogs.length}}" class="empty recent-empty">还没有记录。开始一次计时，或补录过去的时间。</view>
    <scroll-view wx:else class="recent-logs" scroll-x="{{recentScrollEnabled}}" scroll-left="{{recentScrollLeft}}" scroll-with-animation="{{recentScrollWithAnimation}}" bindscroll="onRecentScroll" bindtouchstart="onRecentTouchStart" bindtouchmove="onRecentTouchMove" bindtouchend="onRecentTouchEnd">
      <view class="recent-columns {{recentBoundaryIsDragging ? 'is-boundary-dragging' : ''}}" style="transform: translateX({{recentBoundaryOffset}}px);">
        <view wx:for="{{recentLogs}}" wx:key="id" class="recent-column">
          <view class="recent-log-row">
            <view class="recent-log-note">
              <view class="recent-log-note-text">{{item.displayNote}}</view>
              <view wx:if="{{item.isCandidate}}" class="recent-candidate-icon" role="img" aria-label="自动生成，待确认"><view class="recent-candidate-spark"></view></view>
            </view>
            <view class="recent-log-time muted">{{item.displayTime}}</view>
            <view class="recent-log-tags" data-index="{{index}}" catchtouchstart="onRecentTagTouchStart" catchtouchmove="onRecentTagTouchMove" catchtouchend="onRecentTagTouchEnd" catchtouchcancel="onRecentTagTouchEnd" aria-label="标签">
              <view class="recent-log-tags-content" style="transform: translateX(-{{item.tagScrollLeft}}px);">
                <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="recent-log-tag">{{tag}}</view>
              </view>
            </view>
          </view>
        </view>
        <view class="recent-scroll-tail" aria-hidden="true"></view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{recoveryDraft}}" class="recovery-draft">
    <view class="section-title">有一条待修正的恢复草稿</view>
    <view class="muted">{{recoveryDraft.displayReason}}</view>
    <button class="secondary" bindtap="openRecoveryManual">修正并确认记录</button>
  </view>
  <view class="timer-card">
    <view class="status">{{statusLabel}}</view>
    <view class="elapsed">{{elapsed}}</view>
    <view class="unit">时 : 分 : 秒 · 记录时长 {{elapsedMinutes}} 分钟</view>
    <button class="primary" bindtap="onPrimary">{{primaryLabel}}</button>
    <button wx:if="{{timer.status !== 'idle' && timer.status !== 'ended'}}" class="secondary" bindtap="onFinishTimer">结束计时</button>
  </view>

  <view wx:if="{{showDebugTools}}" class="debug-dock debug-dock--{{debugPanelDock}}">
    <view class="debug-dock-tab" role="button" aria-label="{{debugPanelExpanded ? '收起开发调试工具' : '展开开发调试工具'}}" bindtouchstart="onDebugDockTouchStart" bindtouchend="onDebugDockTouchEnd" bindtap="toggleDebugPanel">
      {{debugPanelExpanded ? '收起' : '调试'}}
    </view>
    <view wx:if="{{debugPanelExpanded}}" class="debug-panel" catchtap="noop">
      <view class="debug-panel-title">开发调试</view>
      <view class="debug-panel-hint">会立即创建一条待修正的恢复草稿。</view>
      <button class="debug-failure-button" bindtap="onDebugTimerFailure">测试计时失败</button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">本次记录</view>
    <input class="text-input" placeholder="备注（可稍后补充）" value="{{note}}" bindinput="onNoteInput" />
    <view class="tag-editor" aria-label="标签">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-chip tag-chip-removable" role="button" data-tags-key="tags" data-input-visible-key="tagInputVisible" data-index="{{index}}" bindtap="removeTag" aria-label="移除标签 {{item}}">{{item}}<text class="tag-chip-remove">×</text></view>
      <input wx:if="{{tagInputVisible}}" class="tag-chip tag-input" focus placeholder="输入一个标签" data-tags-key="tags" data-input-visible-key="tagInputVisible" bindconfirm="addTag" bindblur="onTagInputBlur" />
      <view wx:else class="tag-chip tag-add" role="button" data-tags-key="tags" data-input-visible-key="tagInputVisible" bindtap="openTagInput" aria-label="添加标签">+</view>
    </view>
    <view class="tag-hint">最多 {{maxTagsPerLog}} 个，每个 {{maxTagLength}} 个字符</view>
    <view class="picker-row">
      <picker range="{{events}}" range-key="title" value="{{eventIndex}}" data-key="eventIndex" bindchange="onPickerChange"><view>计划块：{{events[eventIndex].title || '计划外'}}</view></picker>
    </view>
    <button wx:if="{{timer.status !== 'idle'}}" class="link-button" bindtap="onSaveTimerDraft">保存本次字段</button>
  </view>

  <view wx:if="{{showManual}}" class="modal-mask" bindtap="closeManual">
    <view class="modal" catchtap="noop">
      <sheet-header title="{{manualMode === 'recovery' ? '修正恢复草稿' : '手工补录'}}" show-confirm="{{true}}" bind:confirm="onManualSave" bind:cancel="closeManual" />
      <picker mode="date" value="{{manualStartDate}}" data-key="manualStartDate" bindchange="onManualField"><view class="picker-field">开始日期：{{manualStartDate}}</view></picker>
      <picker mode="time" value="{{manualStartTime}}" data-key="manualStartTime" bindchange="onManualField"><view class="picker-field">开始：{{manualStartTime}}</view></picker>
      <picker mode="date" value="{{manualEndDate}}" data-key="manualEndDate" bindchange="onManualField"><view class="picker-field">结束日期：{{manualEndDate}}</view></picker>
      <picker mode="time" value="{{manualEndTime}}" data-key="manualEndTime" bindchange="onManualField"><view class="picker-field">结束：{{manualEndTime}}</view></picker>
      <picker range="{{manualEvents}}" range-key="title" value="{{manualEventIndex}}" data-key="manualEventIndex" bindchange="onPickerChange"><view class="picker-field">计划块：{{manualEvents[manualEventIndex].title || '计划外'}}</view></picker>
      <input class="text-input" placeholder="备注（可选）" value="{{manualNote}}" data-key="manualNote" bindinput="onManualField" />
      <view class="tag-editor" aria-label="标签">
        <view wx:for="{{manualTags}}" wx:key="*this" class="tag-chip tag-chip-removable" role="button" data-tags-key="manualTags" data-input-visible-key="manualTagInputVisible" data-index="{{index}}" bindtap="removeTag" aria-label="移除标签 {{item}}">{{item}}<text class="tag-chip-remove">×</text></view>
        <input wx:if="{{manualTagInputVisible}}" class="tag-chip tag-input" focus placeholder="输入一个标签" data-tags-key="manualTags" data-input-visible-key="manualTagInputVisible" bindconfirm="addTag" bindblur="onTagInputBlur" />
        <view wx:else class="tag-chip tag-add" role="button" data-tags-key="manualTags" data-input-visible-key="manualTagInputVisible" bindtap="openTagInput" aria-label="添加标签">+</view>
      </view>
      <view class="tag-hint">最多 {{maxTagsPerLog}} 个，每个 {{maxTagLength}} 个字符</view>
    </view>
  </view>
</view>
