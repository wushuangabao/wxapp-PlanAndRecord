<view class="page">
  <view class="eyebrow">TRACK YOUR TIME</view>
  <view class="section recent-section">
    <view class="recent-header">
      <view class="section-title recent-title">最近记录</view>
      <view class="recent-action" role="button" aria-label="手工补录" bindtap="openManual">手工补录</view>
    </view>
    <view wx:if="{{!recentLogs.length}}" class="empty recent-empty">还没有记录。开始一次计时，或补录过去的时间。</view>
    <scroll-view wx:else class="recent-logs" scroll-x="{{recentScrollEnabled}}" scroll-left="{{recentScrollLeft}}" scroll-with-animation="{{recentScrollWithAnimation}}" bindscroll="onRecentScroll" bindtouchstart="onRecentTouchStart" bindtouchmove="onRecentTouchMove" bindtouchend="onRecentTouchEnd">
      <view class="recent-columns {{recentBoundaryIsDragging ? 'is-boundary-dragging' : ''}}" style="transform: translateX({{recentBoundaryOffset}}px);">
        <view wx:for="{{recentLogs}}" wx:key="id" class="recent-column">
          <view class="recent-log-row">
            <view class="recent-log-note">
              <view class="recent-log-note-text">{{item.displayTitle}}</view>
              <text wx:if="{{item.isCandidate}}" class="recent-auto-badge" aria-label="自动生成，待确认">auto</text>
              <text wx:if="{{item.isNew}}" class="recent-new-badge" aria-label="新记录">new</text>
              <view class="recent-log-actions">
                <view class="recent-icon-button recent-edit-button" role="button" aria-label="{{item.isCandidate ? '编辑并确认候选' : '编辑记录'}}" data-id="{{item.id}}" bindtap="openRecentLogEditor"><edit-icon /></view>
                <view class="recent-icon-button recent-delete-button" role="button" aria-label="删除记录" data-id="{{item.id}}" bindtap="confirmDeleteRecentLog"><delete-icon /></view>
              </view>
            </view>
            <view class="recent-log-time muted">{{item.displayTime}}</view>
            <view class="recent-log-tags" data-index="{{index}}" catchtouchstart="onRecentTagTouchStart" catchtouchmove="onRecentTagTouchMove" catchtouchend="onRecentTagTouchEnd" catchtouchcancel="onRecentTagTouchEnd" aria-label="标签">
              <view class="recent-log-tags-content" style="transform: translateX(-{{item.tagScrollLeft}}px);">
                <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="recent-log-tag">{{tag}}</view>
              </view>
            </view>
          </view>
        </view>
        <view class="recent-scroll-tail" aria-hidden="true"></view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{recoveryDraft}}" class="recovery-draft">
    <view class="section-title">{{recoveryDraft.displayTitle}}</view>
    <view class="muted">{{recoveryDraft.displayReason}}</view>
    <view class="recovery-draft-actions">
      <button class="secondary" bindtap="openRecoveryManual">{{recoveryDraft.confirmLabel}}</button>
      <button class="danger-button" bindtap="onDiscardRecoveryDraft">放弃并删除记录</button>
    </view>
  </view>
  <view wx:if="{{showDiscardRecoveryConfirm}}" class="modal-mask" bindtap="cancelDiscardRecoveryDraft">
    <view class="modal recovery-discard-modal" catchtap="noop">
      <sheet-header title="{{recoveryDraft.discardTitle}}" show-confirm="{{true}}" confirm-text="删除" cancel-text="保留" bind:confirm="confirmDiscardRecoveryDraft" bind:cancel="cancelDiscardRecoveryDraft" />
      <view class="modal-confirm-copy">{{recoveryDraft.discardCopy}}</view>
    </view>
  </view>
  <view wx:if="{{showDebugTools}}" class="debug-dock debug-dock--{{debugPanelDock}}">
    <view class="debug-dock-tab" role="button" aria-label="{{debugPanelExpanded ? '收起开发调试工具' : '展开开发调试工具'}}" bindtouchstart="onDebugDockTouchStart" bindtouchend="onDebugDockTouchEnd" bindtap="toggleDebugPanel">
      {{debugPanelExpanded ? '收起' : '调试'}}
    </view>
    <view wx:if="{{debugPanelExpanded}}" class="debug-panel" catchtap="noop">
      <view class="debug-panel-title">开发调试</view>
      <view class="debug-panel-hint">会立即创建一条待修正的恢复草稿。</view>
      <button class="debug-failure-button" bindtap="onDebugTimerFailure">测试计时失败</button>
    </view>
  </view>

  <view class="section {{recoveryDraft ? 'record-section--after-recovery' : ''}}">
    <view class="record-header">
      <view class="section-title record-title">本次记录</view>
      <view class="picker-row record-plan-picker">
        <picker range="{{events}}" range-key="title" value="{{eventIndex}}" data-key="eventIndex" bindchange="onPickerChange"><view class="record-plan-picker-value">{{events[eventIndex].title || '计划外'}}</view></picker>
      </view>
    </view>
    <view class="timer-card">
      <view class="status">{{statusLabel}}</view>
      <view class="elapsed">{{elapsed}}</view>
      <view class="timer-actions {{timer.status === 'idle' ? 'timer-actions--single' : ''}}">
        <button wx:if="{{!recoveryDraft || timer.status !== 'idle'}}" class="primary" bindtap="onPrimary">{{primaryLabel}}</button>
        <button wx:if="{{timer.status !== 'idle'}}" class="secondary" bindtap="onFinishTimer">结束计时</button>
      </view>
    </view>
    <input class="text-input" placeholder="备注（可稍后补充）" value="{{note}}" bindinput="onNoteInput" />
    <view wx:if="{{tagCandidates.length && tagInputVisible}}" class="tag-candidates" aria-label="常用标签">
      <view class="tag-candidate-heading"><text class="tag-candidate-title">常用标签</text><text class="tag-candidate-caption">来自其他记录，点击添加</text></view>
      <scroll-view class="tag-candidate-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" data-tags-key="tags" data-input-visible-key="tagInputVisible" bindtouchstart="onTagCandidateTouchStart" bindtouchmove="onTagCandidateTouchMove" bindtouchend="onTagCandidateTouchEnd" bindtouchcancel="onTagCandidateTouchCancel">
        <view class="tag-candidate-list"><view wx:for="{{tagCandidates}}" wx:key="*this" class="tag-candidate-chip" role="button" data-tag="{{item}}" aria-label="添加候选标签 {{item}}">#{{item}}</view></view>
      </scroll-view>
    </view>
    <view class="tag-editor" aria-label="标签">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-chip tag-chip-removable" aria-label="标签 {{item}}"><view class="tag-chip-label">{{item}}</view><view class="tag-chip-remove" role="button" data-tags-key="tags" data-index="{{index}}" catchtap="removeTag" aria-label="移除标签 {{item}}">×</view></view>
      <input wx:if="{{tagInputVisible}}" class="tag-input" focus="{{tagInputAutoFocus}}" maxlength="10" placeholder="输入新标签" placeholder-style="color: #737b75;" data-tags-key="tags" data-input-visible-key="tagInputVisible" bindconfirm="addTag" bindblur="onTagInputBlur" />
      <view wx:else class="tag-chip tag-add" role="button" data-tags-key="tags" data-input-visible-key="tagInputVisible" bindtap="openTagInput" aria-label="添加标签">+</view>
    </view>
    <view class="tag-hint">最多添加 {{maxTagsPerLog}} 个标签</view>
  </view>

  <view wx:if="{{showManual}}" class="modal-mask" bindtap="closeManual">
    <view class="modal" catchtap="noop">
      <sheet-header title="{{manualMode === 'recovery' ? '修正恢复草稿' : (manualMode === 'edit' ? (manualEditingCandidate ? '编辑并确认候选' : '编辑记录') : '手工补录')}}" show-confirm="{{true}}" confirm-text="{{manualEditingCandidate ? '确认记录' : '确定'}}" bind:confirm="onManualSave" bind:cancel="closeManual" />
      <view wx:if="{{manualEditingCandidate}}" class="candidate-confirm-hint" role="note">保存后将转为实际记录，并计入默认统计。</view>
      <view class="manual-time-row">
        <view class="manual-field-label">开始时间</view>
        <picker class="manual-date-picker" mode="date" value="{{manualStartDate}}" data-key="manualStartDate" bindchange="onManualField"><view class="picker-field">{{manualStartDate}}</view></picker>
        <second-time-picker class="manual-time-picker" value="{{manualStartTime}}" data-key="manualStartTime" data-edited-key="manualStartTimeEdited" bind:change="onManualTimeChange" />
      </view>
      <view class="manual-time-row">
        <view class="manual-field-label">结束时间</view>
        <picker class="manual-date-picker" mode="date" value="{{manualEndDate}}" data-key="manualEndDate" bindchange="onManualField"><view class="picker-field">{{manualEndDate}}</view></picker>
        <second-time-picker class="manual-time-picker" value="{{manualEndTime}}" data-key="manualEndTime" data-edited-key="manualEndTimeEdited" bind:change="onManualTimeChange" />
      </view>
      <view class="manual-picker-row">
        <view class="manual-field-label">暂停时长</view>
        <pause-duration-input class="manual-picker-control" value="{{manualPausedDurationSeconds}}" bind:change="onManualPausedDurationChange" />
      </view>
      <view class="manual-picker-row">
        <view class="manual-field-label">计划块</view>
        <picker class="manual-picker-control" range="{{manualEvents}}" range-key="title" value="{{manualEventIndex}}" data-key="manualEventIndex" bindchange="onPickerChange"><view class="picker-field">{{manualEvents[manualEventIndex].title || '计划外'}}</view></picker>
      </view>
      <input class="text-input" placeholder="备注（可选）" value="{{manualNote}}" data-key="manualNote" bindinput="onManualField" />
      <view wx:if="{{manualTagCandidates.length && manualTagInputVisible}}" class="tag-candidates" aria-label="常用标签">
        <view class="tag-candidate-heading"><text class="tag-candidate-title">常用标签</text><text class="tag-candidate-caption">来自其他记录，点击添加</text></view>
        <scroll-view class="tag-candidate-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" data-tags-key="manualTags" data-input-visible-key="manualTagInputVisible" bindtouchstart="onTagCandidateTouchStart" bindtouchmove="onTagCandidateTouchMove" bindtouchend="onTagCandidateTouchEnd" bindtouchcancel="onTagCandidateTouchCancel">
          <view class="tag-candidate-list"><view wx:for="{{manualTagCandidates}}" wx:key="*this" class="tag-candidate-chip" role="button" data-tag="{{item}}" aria-label="添加候选标签 {{item}}">#{{item}}</view></view>
        </scroll-view>
      </view>
      <view class="tag-editor" aria-label="标签">
        <view wx:for="{{manualTags}}" wx:key="*this" class="tag-chip tag-chip-removable" aria-label="标签 {{item}}"><view class="tag-chip-label">{{item}}</view><view class="tag-chip-remove" role="button" data-tags-key="manualTags" data-index="{{index}}" catchtap="removeTag" aria-label="移除标签 {{item}}">×</view></view>
        <input wx:if="{{manualTagInputVisible}}" class="tag-input" focus="{{manualTagInputAutoFocus}}" maxlength="10" placeholder="输入新标签" placeholder-style="color: #737b75;" data-tags-key="manualTags" data-input-visible-key="manualTagInputVisible" bindconfirm="addTag" bindblur="onTagInputBlur" />
        <view wx:else class="tag-chip tag-add" role="button" data-tags-key="manualTags" data-input-visible-key="manualTagInputVisible" bindtap="openTagInput" aria-label="添加标签">+</view>
      </view>
      <view class="tag-hint">最多添加 {{maxTagsPerLog}} 个标签</view>
    </view>
  </view>
</view>
