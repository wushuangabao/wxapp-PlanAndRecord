.page { padding: 44rpx 32rpx 72rpx; }
.eyebrow { position: sticky; z-index: 8; top: 0; padding: 14rpx 0; background: #f8fafc; color: #16a34a; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.timer-card { margin-top: 24rpx; padding: 48rpx; border-radius: 32rpx; background: #14532d; color: #ffffff; text-align: center; }
.status { color: #bbf7d0; font-size: 26rpx; }
.elapsed { margin-top: 20rpx; font-size: 96rpx; font-family: monospace; font-weight: 700; }
.unit { margin: 6rpx 0 28rpx; color: #bbf7d0; font-size: 22rpx; }
.primary, .secondary, .outline-button { border-radius: 16rpx; font-size: 28rpx; }
.primary { background: #22c55e; color: #052e16; font-weight: 700; }
.secondary { margin-top: 18rpx; background: #e2e8f0; color: #334155; }
.timer-card .secondary { background: #166534; color: #dcfce7; }
.recovery-draft { margin-top: 28rpx; padding: 32rpx; border: 1rpx solid #f59e0b; border-radius: 24rpx; background: #fffbeb; }
.section { margin-top: 40rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; font-size: 32rpx; font-weight: 700; }
.text-input { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 16rpx; border: 1rpx solid #cbd5e1; border-radius: 12rpx; background: #ffffff; }
.tag-editor { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.tag-chip { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 64rpx; margin: 0; padding: 0 22rpx; border: 0; border-radius: 12rpx; background: #dcfce7; color: #166534; font-size: 26rpx; line-height: 1.2; }
.tag-chip-removable { max-width: 100%; }
.tag-chip-remove { margin-left: 10rpx; color: #15803d; font-size: 30rpx; line-height: 1; }
.tag-add { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; padding: 0; background: #f0fdf4; border: 1rpx dashed #86efac; color: #15803d; font-size: 34rpx; font-weight: 400; }
.tag-input { box-sizing: border-box; width: 176rpx; text-align: left; }
.tag-hint { margin-top: 12rpx; color: #64748b; font-size: 24rpx; line-height: 1.5; }
.picker-row { margin-top: 18rpx; color: #334155; font-size: 26rpx; }
.picker-row picker { padding: 14rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.link-button { margin-top: 18rpx; background: transparent; color: #15803d; font-size: 26rpx; text-align: left; }
.outline-button { width: 100%; margin-top: 28rpx; border: 1rpx solid #22c55e; background: #f0fdf4; color: #166534; }
.empty, .muted { color: #64748b; font-size: 26rpx; line-height: 1.6; }
.log-row { padding: 20rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.modal-mask { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .45); }
.modal { box-sizing: border-box; width: 100%; max-height: 90vh; overflow-y: auto; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #ffffff; }
.modal-title { margin-bottom: 28rpx; font-size: 36rpx; font-weight: 700; }
.picker-field { margin: 18rpx 0; padding: 20rpx; border-radius: 12rpx; background: #f8fafc; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-actions button { flex: 1; margin: 0; }
.small { font-size: 28rpx; }
