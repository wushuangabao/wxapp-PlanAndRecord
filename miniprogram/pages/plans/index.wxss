.page { padding: 44rpx 32rpx 72rpx; }
.eyebrow { position: sticky; z-index: 8; top: 0; padding: 14rpx 0; background: #f3f1ed; color: #55725e; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.muted, .empty, .todo-empty { color: #626b65; font-size: 26rpx; line-height: 1.6; }
.card { margin-top: 24rpx; padding: 30rpx; border-radius: 24rpx; background: #faf9f7; }
.section-header { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; min-height: 44rpx; margin-bottom: 20rpx; }
.section-heading { display: flex; flex: 1; align-items: baseline; gap: 16rpx; min-width: 0; }
.section-title { margin-bottom: 0; font-size: 32rpx; font-weight: 700; }
.section-count, .collapse-mark, .project-task-link { color: #626b65; font-size: 24rpx; }
.todo-card { box-sizing: border-box; height: 420rpx; }
.todo-list, .todo-empty { height: 296rpx; }
.todo-empty { display: flex; align-items: center; }
.todo-columns { display: flex; column-gap: 20%; height: 100%; transition: transform 360ms cubic-bezier(.2,1.35,.45,1); }
.todo-columns.is-boundary-dragging { transition: none; }
.todo-column { display: flex; flex: 0 0 60%; flex-direction: column; box-sizing: border-box; min-width: 0; max-width: 60%; height: 100%; overflow: hidden; }
.todo-scroll-tail { flex: 0 0 20%; }
.todo-row { display: flex; flex: 0 0 33.333333%; align-items: center; box-sizing: border-box; min-width: 0; min-height: 0; gap: 12rpx; }
.todo-check { display: flex; flex: 0 0 36rpx; align-items: center; justify-content: center; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 2rpx solid #a9bdae; border-radius: 10rpx; color: #17251d; font-size: 24rpx; }
.todo-main { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; overflow: hidden; }
.todo-title, .todo-project { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.todo-title { color: #343a36; font-size: 28rpx; font-weight: 400; }
.todo-project { margin-top: 2rpx; color: #626b65; font-size: 22rpx; }
.todo-actions { display: flex; flex: 0 0 112rpx; align-items: center; box-sizing: border-box; width: 112rpx; min-width: 112rpx; }
.todo-icon-button { display: flex; flex: 0 0 56rpx; align-items: center; justify-content: center; box-sizing: border-box; width: 56rpx; height: 56rpx; border-radius: 12rpx; }
.todo-icon-button:active { background: #e6ece7; }
.todo-link-icon { position: relative; width: 44rpx; height: 32rpx; transform: translateY(1rpx); }
.todo-folder-icon { position: absolute; z-index: 1; top: 4rpx; left: 1rpx; width: 29rpx; height: 24rpx; }
.todo-folder-tab { position: absolute; z-index: 2; top: 0; left: 0; width: 12rpx; height: 4rpx; background: #4d695b; }
.todo-folder-tab::after { position: absolute; top: 0; left: 100%; width: 0; height: 0; border-right: 2rpx solid transparent; border-bottom: 4rpx solid #4d695b; content: ''; }
.todo-folder-body { position: absolute; z-index: 1; top: 4rpx; left: 0; box-sizing: border-box; width: 29rpx; height: 20rpx; border: 3rpx solid #4d695b; border-radius: 0 4rpx 4rpx 4rpx; background: #faf9f7; }
.todo-link-arrow { position: absolute; z-index: 3; top: 14rpx; right: 0; width: 18rpx; height: 4rpx; border-radius: 2rpx; background: #4d695b; }
.todo-link-arrow::before { position: absolute; top: 50%; left: -3rpx; box-sizing: border-box; width: 11rpx; height: 11rpx; border-right: 4rpx solid #4d695b; border-bottom: 4rpx solid #4d695b; content: ''; transform: translateY(-50%) rotate(135deg); }
.is-completed .todo-check { border-color: #78947f; background: #d8e1da; }
.is-completed .todo-title, .is-completed .todo-project { color: #737b75; text-decoration: line-through; }
.section-add { display: flex; flex: 0 0 54rpx; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #59635d; font-size: 44rpx; font-weight: 300; line-height: 1; }
.project-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.input { box-sizing: border-box; width: 100%; min-height: 74rpx; margin: 14rpx 0; padding: 16rpx; border: 1rpx solid #d0cdc6; border-radius: 12rpx; }
.task-project-picker { box-sizing: border-box; min-height: 74rpx; margin: 14rpx 0; padding: 16rpx; border: 1rpx solid #d0cdc6; border-radius: 12rpx; color: #505a54; font-size: 28rpx; line-height: 42rpx; }
.task-project-modal { max-height: 78vh; padding: 36rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: #ece9e4; }
.task-project-options { box-sizing: border-box; max-height: 56vh; background: #faf9f7; }
.task-project-option { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 96rpx; margin: 0; padding: 18rpx 24rpx; border-radius: 0; background: #faf9f7; color: #343a36; font-size: 30rpx; font-weight: 400; line-height: 1.4; text-align: center; }
.task-project-option::after { border: 0; }
.task-project-option + .task-project-option { border-top: 1rpx solid #dedad3; }
.task-project-unlink { color: #9a5550; }
.field-row { display: flex; gap: 16rpx; margin: 14rpx 0; }
.field-row > picker, .field-row > input { flex: 1; padding: 16rpx; border-radius: 12rpx; background: #f3f1ed; }
.field-row .input { margin: 0; background: #faf9f7; }
.project-deadline-row { display: flex; align-items: center; gap: 16rpx; margin: 14rpx 0; }
.project-deadline-label { flex: 0 0 112rpx; color: #626b65; font-size: 26rpx; line-height: 42rpx; }
.project-deadline-row picker { box-sizing: border-box; min-height: 74rpx; padding: 16rpx; border-radius: 12rpx; background: #f3f1ed; color: #343a36; font-size: 28rpx; line-height: 42rpx; }
.project-deadline-date { flex: 1; min-width: 0; }
.project-deadline-time { flex: 0 0 180rpx; }
.primary, .secondary { margin-top: 12rpx; border-radius: 14rpx; font-size: 28rpx; }
.primary { background: #78947f; color: #faf9f7; font-weight: 700; }
.secondary { background: #d8e1da; color: #486455; }
.item { padding: 24rpx 0; border-top: 1rpx solid #dedad3; }
.project-item:first-of-type { border-top: 0; }
.item-title { font-size: 30rpx; font-weight: 600; }
.actions { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 14rpx; }
.text-button, .danger-button { display: inline; width: auto; min-width: 0; margin: 0; padding: 0; background: transparent; color: #4d695b; font-size: 25rpx; line-height: 1.4; text-align: left; }
.danger-button { color: #9a5550; }
.okr { margin-top: 14rpx; padding: 16rpx; border-left: 6rpx solid #a9bdae; background: #e6ece7; font-size: 26rpx; }
.wish-toggle { margin-bottom: 0; }
.wish-content { margin-top: 20rpx; }
.modal-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(52,58,54,.42); }
.modal { box-sizing: border-box; width: 100%; max-height: 82vh; overflow-y: auto; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #faf9f7; }
.task-tabs { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.task-tab { flex: 1; margin: 0; border-radius: 14rpx; background: #ece9e4; color: #626b65; font-size: 26rpx; }
.task-tab.is-active { background: #d8e1da; color: #486455; }
