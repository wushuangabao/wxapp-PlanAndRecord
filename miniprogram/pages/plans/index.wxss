.page { padding: 44rpx 32rpx 72rpx; }
.hero { margin-bottom: 30rpx; }
.eyebrow { position: sticky; z-index: 8; top: 0; padding: 14rpx 0; background: #f8fafc; color: #16a34a; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { margin-top: 16rpx; font-size: 56rpx; font-weight: 700; }
.subtitle, .muted, .empty, .todo-empty { color: #64748b; font-size: 26rpx; line-height: 1.6; }
.card { margin-top: 24rpx; padding: 30rpx; border-radius: 24rpx; background: #ffffff; }
.section-header { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; min-height: 44rpx; margin-bottom: 20rpx; }
.section-heading { display: flex; flex: 1; align-items: baseline; gap: 16rpx; min-width: 0; }
.section-title { margin-bottom: 0; font-size: 32rpx; font-weight: 700; }
.section-count, .collapse-mark, .project-task-link { color: #64748b; font-size: 24rpx; }
.todo-card { box-sizing: border-box; height: 420rpx; }
.todo-list, .todo-empty { height: 296rpx; }
.todo-empty { display: flex; align-items: center; }
.todo-columns { display: flex; column-gap: 20%; height: 100%; }
.todo-column { display: flex; flex: 0 0 60%; flex-direction: column; box-sizing: border-box; min-width: 0; max-width: 60%; height: 100%; overflow: hidden; }
.todo-scroll-tail { flex: 0 0 20%; }
.todo-row { display: flex; flex: 0 0 33.333333%; align-items: center; box-sizing: border-box; min-width: 0; min-height: 0; gap: 12rpx; }
.todo-check { display: flex; flex: 0 0 36rpx; align-items: center; justify-content: center; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 2rpx solid #86efac; border-radius: 10rpx; color: #052e16; font-size: 24rpx; }
.todo-main { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; overflow: hidden; }
.todo-title, .todo-project { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.todo-title { color: #0f172a; font-size: 28rpx; font-weight: 400; }
.todo-project { margin-top: 2rpx; color: #64748b; font-size: 22rpx; }
.todo-icon-button { display: flex; flex: 0 0 56rpx; align-items: center; justify-content: center; box-sizing: border-box; width: 56rpx; height: 56rpx; margin: 0; padding: 0; border: 0; background: transparent; }
.todo-icon-button::after { border: 0; }
.todo-link-icon { position: relative; width: 42rpx; height: 30rpx; }
.todo-folder-stack { position: absolute; z-index: 1; top: 10rpx; left: 2rpx; box-sizing: border-box; width: 19rpx; height: 14rpx; border: 2.5rpx solid #15803d; border-radius: 3rpx; background: #ffffff; }
.todo-folder-stack::before, .todo-folder-stack::after, .todo-link-arrow::before, .todo-link-arrow::after { position: absolute; box-sizing: border-box; content: ''; }
.todo-folder-stack::before { z-index: -1; top: -6rpx; left: 4rpx; width: 19rpx; height: 14rpx; border: 2.5rpx solid #15803d; border-radius: 3rpx; background: #ffffff; }
.todo-folder-stack::after { top: -6rpx; left: 2rpx; width: 8rpx; height: 5rpx; border: 2.5rpx solid #15803d; border-bottom: 0; border-radius: 3rpx 3rpx 0 0; background: #ffffff; }
.todo-link-arrow { position: absolute; top: 14rpx; right: 0; width: 13rpx; height: 3rpx; border-radius: 2rpx; background: #15803d; }
.todo-link-arrow::before, .todo-link-arrow::after { left: -1rpx; width: 8rpx; height: 3rpx; border-radius: 2rpx; background: #15803d; transform-origin: left center; }
.todo-link-arrow::before { top: -3rpx; transform: rotate(-40deg); }
.todo-link-arrow::after { top: 3rpx; transform: rotate(40deg); }
.todo-delete-icon { position: relative; box-sizing: border-box; width: 22rpx; height: 25rpx; margin-top: 4rpx; border: 3rpx solid #dc2626; border-top: 0; border-radius: 0 0 4rpx 4rpx; transform: scale(.85); }
.todo-delete-icon::before, .todo-delete-icon::after { position: absolute; background: #dc2626; content: ''; }
.todo-delete-icon::before { top: -6rpx; left: -5rpx; width: 26rpx; height: 3rpx; border-radius: 2rpx; }
.todo-delete-icon::after { top: -10rpx; left: 5rpx; width: 8rpx; height: 4rpx; border-radius: 2rpx 2rpx 0 0; }
.todo-delete-lines { position: absolute; top: 6rpx; left: 5rpx; width: 2rpx; height: 12rpx; border-radius: 1rpx; background: #dc2626; box-shadow: 7rpx 0 0 #dc2626; }
.is-completed .todo-check { border-color: #22c55e; background: #dcfce7; }
.is-completed .todo-title, .is-completed .todo-project { color: #94a3b8; text-decoration: line-through; }
.section-add { display: flex; flex: 0 0 54rpx; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #475569; font-size: 44rpx; font-weight: 300; line-height: 1; }
.project-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.input { box-sizing: border-box; width: 100%; min-height: 74rpx; margin: 14rpx 0; padding: 16rpx; border: 1rpx solid #cbd5e1; border-radius: 12rpx; }
.task-project-picker { box-sizing: border-box; min-height: 74rpx; margin: 14rpx 0; padding: 16rpx; border: 1rpx solid #cbd5e1; border-radius: 12rpx; color: #334155; font-size: 28rpx; line-height: 42rpx; }
.field-row { display: flex; gap: 16rpx; margin: 14rpx 0; }
.field-row > picker, .field-row > input { flex: 1; padding: 16rpx; border-radius: 12rpx; background: #f8fafc; }
.field-row .input { margin: 0; background: #ffffff; }
.primary, .secondary { margin-top: 12rpx; border-radius: 14rpx; font-size: 28rpx; }
.primary { background: #22c55e; color: #052e16; font-weight: 700; }
.secondary { background: #dcfce7; color: #166534; }
.item { padding: 24rpx 0; border-top: 1rpx solid #eef2f7; }
.project-item:first-of-type { border-top: 0; }
.item-title { font-size: 30rpx; font-weight: 600; }
.actions { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 14rpx; }
.text-button, .danger-button { display: inline; width: auto; min-width: 0; margin: 0; padding: 0; background: transparent; color: #15803d; font-size: 25rpx; line-height: 1.4; text-align: left; }
.danger-button { color: #dc2626; }
.okr { margin-top: 14rpx; padding: 16rpx; border-left: 6rpx solid #86efac; background: #f0fdf4; font-size: 26rpx; }
.wish-toggle { margin-bottom: 0; }
.wish-content { margin-top: 20rpx; }
.modal-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.45); }
.modal { box-sizing: border-box; width: 100%; max-height: 82vh; overflow-y: auto; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #ffffff; }
.modal-title { margin-bottom: 20rpx; color: #0f172a; font-size: 36rpx; font-weight: 700; }
.modal .link { display: block; width: 100%; margin-top: 28rpx; text-align: center; }
.link { display: inline; margin: 0; padding: 0; background: transparent; color: #15803d; font-size: 25rpx; }
.task-tabs { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.task-tab { flex: 1; margin: 0; border-radius: 14rpx; background: #f1f5f9; color: #64748b; font-size: 26rpx; }
.task-tab.is-active { background: #dcfce7; color: #166534; }
