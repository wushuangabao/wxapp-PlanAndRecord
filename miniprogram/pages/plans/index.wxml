<view class="page">
  <view class="eyebrow">FOCUS ON WHAT MATTERS</view>

  <view class="card wish-card">
    <view class="section-header wish-toggle" bindtap="toggleWishSection"><view class="section-title">愿望池（{{wishes.length}}）</view><view class="collapse-mark">{{isWishExpanded ? '收起' : '展开'}}</view></view>
    <view wx:if="{{isWishExpanded}}" class="wish-content">
      <view wx:if="{{!wishes.length}}" class="wish-empty is-one-row">还没有愿望，可以在下方创建一条。</view>
      <scroll-view wx:else class="wish-list {{wishes.length === 1 ? 'is-one-row' : (wishes.length === 2 ? 'is-two-rows' : '')}}" scroll-x="{{true}}" scroll-left="{{wishScrollLeft}}" scroll-with-animation="{{wishScrollWithAnimation}}" bindscroll="onWishScroll" bindtouchstart="onWishTouchStart" bindtouchmove="onWishTouchMove" bindtouchend="onWishTouchEnd">
        <view class="wish-columns {{wishBoundaryIsDragging ? 'is-boundary-dragging' : ''}}" style="transform: translateX({{wishBoundaryOffset}}px);">
          <view wx:for="{{wishListColumns}}" wx:for-item="column" wx:key="id" class="wish-column">
            <view wx:for="{{column.wishes}}" wx:for-item="wish" wx:key="id" class="item wish-row">
              <view class="wish-main"><input wx:if="{{wishTitleEditId === wish.id}}" class="wish-title-input" focus="{{true}}" maxlength="-1" value="{{wishTitleEditValue}}" aria-label="编辑愿望标题" catchtap="noop" bindinput="onWishTitleInput" bindblur="saveWishTitle" bindconfirm="saveWishTitle" /><view wx:else class="wish-title wish-title-button" role="button" aria-label="编辑愿望标题" data-id="{{wish.id}}" bindtap="openWishTitleEditor">{{wish.title}}</view></view>
              <view class="wish-actions">
                <view class="wish-icon-button wish-convert-button" role="button" aria-label="转为项目" data-id="{{wish.id}}" bindtap="convertWish"><view class="todo-link-icon"><view class="todo-folder-icon"><view class="todo-folder-tab"></view><view class="todo-folder-body"></view></view><view class="todo-link-arrow"></view></view></view>
                <view class="wish-icon-button wish-delete-button" role="button" aria-label="删除愿望" data-id="{{wish.id}}" bindtap="confirmDeleteWish"><delete-icon /></view>
              </view>
            </view>
          </view>
          <view class="wish-scroll-tail" aria-hidden="true"></view>
        </view>
      </scroll-view>
      <view class="wish-create-row">
        <input class="input wish-create-input" maxlength="-1" placeholder="愿望描述（最多 25 字）" value="{{wishTitle}}" data-key="wishTitle" bindinput="onTitleField" />
        <button class="secondary wish-create-button" bindtap="addWish">许愿</button>
      </view>
    </view>
  </view>

  <view class="card todo-card {{todoListTasks.length < 2 ? 'is-one-row' : (todoListTasks.length === 2 ? 'is-two-rows' : '')}}">
    <view class="section-header"><view class="section-heading"><view class="section-title">TODO LIST（{{todoListTasks.length}}）</view></view><view class="todo-header-actions"><view class="todo-sort-button" role="button" aria-label="调整 TODO 排序" bindtap="openTodoSort"><view aria-hidden="true">⇅</view></view><view class="section-add todo-add" role="button" aria-label="新建 TODO" bindtap="openStandaloneTask">+</view></view></view>
    <view wx:if="{{!todoListTasks.length}}" class="todo-empty is-one-row">还没有 TODO，点右上角 + 创建一条。</view>
    <scroll-view wx:else class="todo-list {{todoListTasks.length === 1 ? 'is-one-row' : (todoListTasks.length === 2 ? 'is-two-rows' : '')}}" scroll-x="{{true}}" scroll-left="{{todoScrollLeft}}" scroll-with-animation="{{todoScrollWithAnimation}}" bindscroll="onTodoScroll" bindtouchstart="onTodoTouchStart" bindtouchmove="onTodoTouchMove" bindtouchend="onTodoTouchEnd">
      <view class="todo-columns {{todoBoundaryIsDragging ? 'is-boundary-dragging' : ''}}" style="transform: translateX({{todoBoundaryOffset}}px);">
        <view wx:for="{{todoListColumns}}" wx:for-item="column" wx:key="id" class="todo-column">
          <view wx:for="{{column.tasks}}" wx:for-item="task" wx:key="id" class="item todo-row {{task.status === 'completed' ? 'is-completed' : ''}} {{task.recordedToday ? 'is-recorded-today' : ''}} {{task.timerMatchesTask ? 'is-timer-active' : ''}}">
            <view class="todo-control" role="button" aria-label="{{task.status === 'completed' ? '重新打开任务' : (task.controlKind === 'timer' ? (task.timerMatchesTask ? '查看任务计时' : '从关联计划开始计时') : (task.controlKind === 'recorded' ? '今天的固定日程已记录' : (task.controlKind === 'schedule' ? '今天没有这项固定日程' : '完成任务')))}}" data-id="{{task.id}}" data-status="{{task.status}}" bindtap="toggleTask">
              <view wx:if="{{task.status === 'completed' || task.controlKind === 'checkbox'}}" class="todo-check">{{task.status === 'completed' ? '✓' : ''}}</view>
              <view wx:else class="todo-timer-icon {{task.controlKind === 'schedule' ? 'is-schedule' : ''}} {{task.controlKind === 'recorded' ? 'is-recorded' : ''}} {{task.timerStatus === 'running' ? 'is-running' : ''}} {{task.timerStatus === 'paused' ? 'is-paused' : ''}}" aria-hidden="true"><view class="todo-timer-crown"></view><view class="todo-timer-hand"></view><view wx:if="{{task.timerStatus === 'paused'}}" class="todo-timer-pause">Ⅱ</view></view>
            </view>
            <view class="todo-main"><input wx:if="{{todoTitleEditTaskId === task.id && todoTitleEditSource === 'todo'}}" class="todo-title-input" focus="{{true}}" maxlength="-1" value="{{todoTitleEditValue}}" style="font-size: {{task.todoTitleFontSize}}rpx;" aria-label="编辑 TODO 标题" catchtap="noop" bindinput="onTodoTitleInput" bindblur="saveTodoTitle" bindconfirm="saveTodoTitle" /><view wx:else class="todo-title todo-title-button" role="button" aria-label="编辑 TODO 标题" data-id="{{task.id}}" data-edit-source="todo" style="font-size: {{task.todoTitleFontSize}}rpx;" bindtap="openTodoTitleEditor">{{task.title}}</view><view wx:if="{{task.projectDisplayName}}" class="todo-project">{{task.projectDisplayName}}</view></view>
            <view class="todo-actions">
              <view class="todo-icon-button todo-link-button" role="button" aria-label="关联项目" data-id="{{task.id}}" bindtap="chooseTaskProject"><view class="todo-link-icon"><view class="todo-folder-icon"><view class="todo-folder-tab"></view><view class="todo-folder-body"></view></view><view class="todo-link-arrow"></view></view></view>
              <view class="todo-icon-button todo-delete-button" role="button" aria-label="删除" data-id="{{task.id}}" bindtap="confirmDeleteTask"><delete-icon /></view>
            </view>
          </view>
        </view>
        <view class="todo-scroll-tail" aria-hidden="true"></view>
      </view>
    </scroll-view>
  </view>

  <view class="card">
    <view class="section-header"><view class="section-heading"><view class="section-title">项目（{{activeProjects.length}} / 5）</view></view><view wx:if="{{activeProjects.length < 5}}" class="section-add project-add" role="button" aria-label="新建项目" bindtap="openProjectCreate">+</view></view>
    <view wx:if="{{!activeProjects.length}}" class="empty">还没有正在进行的项目。</view>
    <view wx:for="{{projectCards}}" wx:key="id" class="item project-item">
      <view class="project-heading"><view class="project-collapse" role="button" aria-label="{{item.isCollapsed ? '展开项目' : '折叠项目'}}" data-id="{{item.id}}" bindtap="toggleProjectCollapse"><view class="project-collapse-icon {{item.isCollapsed ? 'is-collapsed' : ''}}" aria-hidden="true"></view></view><view class="project-title-deadline"><view class="item-title">{{item.title}}</view><view class="project-deadline-viewport"><view wx:if="{{item.isDeadlineScrolling}}" class="project-deadline-marquee"><view class="project-deadline-copy">截止：{{item.deadlineText}}</view><view class="project-deadline-gap" aria-hidden="true"></view><view class="project-deadline-copy">截止：{{item.deadlineText}}</view></view><view wx:else class="project-deadline-text">截止：{{item.deadlineText}}</view></view><view class="project-deadline-measure" aria-hidden="true">截止：{{item.deadlineText}}</view></view><view class="project-manage" role="button" aria-label="管理项目" data-id="{{item.id}}" bindtap="openProjectManage">…</view></view>
      <block wx:if="{{!item.isCollapsed}}">
        <view class="project-task-columns {{item.completedCount ? 'has-completed' : ''}}">
          <view class="project-task-column project-todo-column">
            <view class="project-column-heading">待处理</view>
            <view wx:if="{{item.hasNoTodoTasks}}" class="project-task-empty">还没有子任务</view>
            <view wx:else class="project-task-list">
              <view wx:for="{{item.todoTasks}}" wx:for-item="task" wx:key="id" class="project-task-row {{task.status === 'completed' ? 'is-completed' : ''}} {{task.recordedToday ? 'is-recorded-today' : ''}} {{task.timerMatchesTask ? 'is-timer-active' : ''}}">
                <view class="project-task-check" role="button" aria-label="{{task.status === 'completed' ? '重新打开子任务' : (task.controlKind === 'timer' ? '从关联计划开始计时' : '完成子任务')}}" data-id="{{task.id}}" data-status="{{task.status}}" bindtap="toggleTask"><view wx:if="{{task.status === 'completed' || task.controlKind === 'checkbox'}}" class="todo-check" aria-hidden="true">{{task.status === 'completed' ? '✓' : ''}}</view><view wx:else class="todo-timer-icon {{task.controlKind === 'schedule' ? 'is-schedule' : ''}} {{task.controlKind === 'recorded' ? 'is-recorded' : ''}} {{task.timerStatus === 'running' ? 'is-running' : ''}} {{task.timerStatus === 'paused' ? 'is-paused' : ''}}" aria-hidden="true"><view class="todo-timer-crown"></view><view class="todo-timer-hand"></view><view wx:if="{{task.timerStatus === 'paused'}}" class="todo-timer-pause">Ⅱ</view></view></view>
                <view class="todo-main"><input wx:if="{{todoTitleEditTaskId === task.id && todoTitleEditSource === 'project'}}" class="todo-title-input" focus="{{true}}" maxlength="-1" value="{{todoTitleEditValue}}" aria-label="编辑 TODO 标题" catchtap="noop" bindinput="onTodoTitleInput" bindblur="saveTodoTitle" bindconfirm="saveTodoTitle" /><view wx:else class="todo-title todo-title-button project-task-title-button" role="button" aria-label="编辑 TODO 标题" data-id="{{task.id}}" data-edit-source="project" bindtap="openTodoTitleEditor">{{task.title}}</view></view>
              </view>
            </view>
            <view class="project-todo-footer">
              <view wx:if="{{item.hasMoreTodoTasks}}" class="project-inline-link" role="button" data-id="{{item.id}}" bindtap="toggleProjectTodoExpansion">{{item.todoToggleText}}</view>
              <view class="project-add-task" role="button" data-id="{{item.id}}" bindtap="openChildTask">{{item.hasNoTasks ? '+ 添加第一项子任务' : '+ 添加子任务'}}</view>
            </view>
          </view>
          <view wx:if="{{item.completedCount}}" class="project-task-column project-completed-column">
            <view class="project-inline-link project-completed-toggle" role="button" aria-label="{{item.isCompletedExpanded ? '收起已完成项' : '展开已完成项'}}" data-id="{{item.id}}" bindtap="toggleProjectCompletedExpansion"><view>已完成 {{item.completedCount}} 项</view><view class="project-completed-chevron {{item.isCompletedExpanded ? 'is-expanded' : ''}}" aria-hidden="true"></view></view>
            <view wx:if="{{item.isCompletedExpanded}}" class="project-completed-list">
              <view wx:for="{{item.completedTasks}}" wx:for-item="task" wx:key="id" class="project-task-row is-completed">
                <view class="project-task-check" role="button" aria-label="{{task.status === 'completed' ? '重新打开子任务' : '完成子任务'}}" data-id="{{task.id}}" data-status="{{task.status}}" bindtap="toggleTask"><view class="todo-check" aria-hidden="true">✓</view></view>
                <view class="todo-main"><input wx:if="{{todoTitleEditTaskId === task.id && todoTitleEditSource === 'project'}}" class="todo-title-input" focus="{{true}}" maxlength="-1" value="{{todoTitleEditValue}}" aria-label="编辑 TODO 标题" catchtap="noop" bindinput="onTodoTitleInput" bindblur="saveTodoTitle" bindconfirm="saveTodoTitle" /><view wx:else class="todo-title todo-title-button project-task-title-button" role="button" aria-label="编辑 TODO 标题" data-id="{{task.id}}" data-edit-source="project" bindtap="openTodoTitleEditor">{{task.title}}</view></view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{archivedProjects.length}}" class="card">
    <view class="section-title">已归档项目</view>
    <view wx:for="{{archivedProjects}}" wx:key="id" class="item project-item">
      <view class="item-title">{{item.title}}</view>
      <view class="muted">截止：{{item.deadlineText}} · 已归档</view>
      <view class="actions"><button class="text-button" data-id="{{item.id}}" bindtap="restoreProject">恢复项目</button></view>
    </view>
  </view>

  <view wx:if="{{isTodoSortOpen}}" class="modal-mask" bindtap="dismissTodoSort"><view class="modal todo-sort-modal" catchtap="noop"><sheet-header title="TODO 排序" show-confirm="{{true}}" bind:confirm="saveTodoSort" bind:cancel="dismissTodoSort" /><view class="todo-sort-intro"><view>从上到下决定排序优先级</view><view class="todo-sort-reset" role="button" aria-label="重置 TODO 排序" bindtap="resetTodoSort">重置</view></view><view class="todo-sort-list"><view wx:for="{{todoSortEditorItems}}" wx:for-item="criterion" wx:key="field" class="todo-sort-row"><view class="todo-sort-priority">{{index + 1}}</view><view class="todo-sort-main"><view class="todo-sort-label">{{criterion.label}}</view><view class="todo-sort-direction">{{criterion.directionLabel}}</view></view><view class="todo-sort-actions"><view wx:if="{{criterion.field !== 'status'}}" class="todo-sort-action" role="button" aria-label="切换 {{criterion.label}} 排序方向" data-index="{{index}}" bindtap="toggleTodoSortDirection">⇅</view><view wx:if="{{criterion.canMoveUp}}" class="todo-sort-action" role="button" aria-label="提高 {{criterion.label}} 排序优先级" data-index="{{index}}" data-direction="up" bindtap="moveTodoSortCriterion">↑</view><view wx:if="{{criterion.canMoveDown}}" class="todo-sort-action" role="button" aria-label="降低 {{criterion.label}} 排序优先级" data-index="{{index}}" data-direction="down" bindtap="moveTodoSortCriterion">↓</view><view wx:if="{{criterion.canRemove}}" class="todo-sort-action todo-sort-remove" role="button" aria-label="移除 {{criterion.label}} 排序" data-index="{{index}}" bindtap="removeTodoSortCriterion">×</view></view></view></view><view wx:if="{{todoSortAvailableFields.length}}" class="todo-sort-add"><view class="todo-sort-add-title">添加排序条件</view><view class="todo-sort-options"><view wx:for="{{todoSortAvailableFields}}" wx:for-item="field" wx:key="field" class="todo-sort-option" role="button" aria-label="添加 {{field.label}} 排序" data-field="{{field.field}}" bindtap="addTodoSortCriterion">+ {{field.label}}</view></view></view></view></view>

  <view wx:if="{{isProjectCreateOpen}}" class="modal-mask" bindtap="closeProjectCreate"><view class="modal project-create-modal" catchtap="noop"><sheet-header title="新建项目" show-confirm="{{true}}" bind:confirm="addProject" bind:cancel="closeProjectCreate" /><input class="input" maxlength="-1" placeholder="项目名称（最多 25 字）" value="{{projectTitle}}" data-key="projectTitle" bindinput="onTitleField" /><view class="project-deadline-row"><view class="project-deadline-label">截止时间</view><picker class="project-deadline-picker project-deadline-date" mode="date" value="{{projectDate}}" data-key="projectDate" bindchange="onField"><view>{{projectDate}}</view></picker><picker class="project-deadline-picker project-deadline-time" mode="time" value="{{projectTime}}" data-key="projectTime" bindchange="onField"><view>{{projectTime}}</view></picker></view></view></view>

  <view wx:if="{{taskProjectPicker}}" class="modal-mask" bindtap="closeTaskProjectPicker"><view class="modal task-project-modal" catchtap="noop"><sheet-header title="{{taskProjectPicker.title}}" bind:cancel="closeTaskProjectPicker" /><scroll-view class="task-project-options" scroll-y="{{true}}" style="height: {{taskProjectPicker.optionsHeight}}rpx;"><button wx:for="{{taskProjectPicker.projects}}" wx:for-item="project" wx:key="id" class="task-project-option" data-id="{{project.id}}" bindtap="selectTaskProject">{{project.title}}</button><button wx:if="{{taskProjectPicker.canUnlink}}" class="task-project-option task-project-unlink" bindtap="unlinkTaskProject">取消关联</button></scroll-view></view></view>

  <view wx:if="{{taskEditor && isTaskEditorOpen}}" class="modal-mask" bindtap="dismissTaskEditor"><view class="modal" catchtap="noop"><sheet-header title="新建 TODO" show-confirm="{{true}}" bind:confirm="saveTaskEditor" bind:cancel="closeTaskEditor" /><input class="input" maxlength="-1" placeholder="任务名称（最多 25 字）" value="{{taskTitle}}" data-key="taskTitle" bindinput="onTitleField" /><view class="todo-set-time-row"><view class="todo-set-time" role="button" aria-label="设定时间" bindtap="openPlanFromTodo">设定时间</view></view></view></view>

  <plan-editor-sheet visible="{{isPlanSheetOpen}}" variant="plans-todo" mode="create" initial-value="{{planEditorInitialValue}}" bind:success="onPlanEditorSuccess" bind:cancel="onPlanEditorCancel" />

  <view wx:if="{{projectEditor && isProjectEditorOpen}}" class="modal-mask" bindtap="dismissProjectEditor"><view class="modal" catchtap="noop"><sheet-header title="编辑项目" show-confirm="{{true}}" bind:confirm="saveProjectEditor" bind:cancel="closeProjectEditor" /><input class="input" maxlength="-1" value="{{projectEditorTitle}}" data-key="projectEditorTitle" bindinput="onTitleField" /><view class="field-row"><picker class="field-row-picker" mode="date" value="{{projectEditorDate}}" data-key="projectEditorDate" bindchange="onField"><view>{{projectEditorDate}}</view></picker><picker class="field-row-picker" mode="time" value="{{projectEditorTime}}" data-key="projectEditorTime" bindchange="onField"><view>{{projectEditorTime}}</view></picker></view></view></view>
</view>
